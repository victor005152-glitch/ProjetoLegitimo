<Page x:Class="ProjetoIntegrador.TelaComprovante"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaComprovante">

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- MENU LATERAL -->
        <Border Width="280"
                Height="1080"
                Background="#CC111827"
                CornerRadius="0,24,24,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"
                       Width="250"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Fill="#33FFFFFF"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                <Button x:Name="BotaoEstoque"
                        Content="📦 Estoque"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoVendas"
                        Content="🛒 Vendas"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Click="BotaoVendas_Click"
                        Background="#FF7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro"
                        Content="   💰 Financeiro"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoEmpresa"
                        Content="⚙️ Empresa"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Click="BotaoEmpresa_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="570"
                        Background="#11FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1.5">

                    <Canvas>
                        <Label Content="🧾 Comprovante"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Prévia de impressão&#x0a;da venda finalizada"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="#FFDC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                Width="1640"
                Height="70"
                Background="#11FFFFFF"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">

            <Canvas>
                <Label Content="Comprovante de Venda"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Canvas.Left="30"
                       Canvas.Top="15"/>

                <Label Content="Visualize e imprima o comprovante da venda"
                       FontSize="14"
                       Foreground="#FFD1D5DB"
                       Canvas.Left="32"
                       Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Transparent">

            <!-- COMPROVANTE -->
            <Border x:Name="AreaComprovante"
                    Width="620"
                    Height="720"
                    Canvas.Left="510"
                    Canvas.Top="25"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1.5">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.25"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="35">

                        <!-- EMPRESA -->
                        <TextBlock x:Name="TxtEmpresa"
                                   Text="EMPRESA"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FF111827"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtRazaoSocial"
                                   Text="Razão Social"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtCnpj"
                                   Text="CNPJ:"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="TxtEndereco"
                                   Text="Endereço"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtContato"
                                   Text="Contato"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,15"
                                   TextWrapping="Wrap"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,0,0,15"/>

                        <!-- DADOS VENDA -->
                        <TextBlock x:Name="TxtNumeroVenda"
                                   Text="Venda Nº 000000"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FF111827"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Data:"
                                       FontWeight="Bold"
                                       FontSize="14"/>

                            <TextBlock x:Name="TxtDataVenda"
                                       Grid.Column="1"
                                       Text="00/00/0000 00:00"
                                       FontSize="14"
                                       TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Operador:"
                                       FontWeight="Bold"
                                       FontSize="14"/>

                            <TextBlock x:Name="TxtOperador"
                                       Grid.Column="1"
                                       Text="Operador"
                                       FontSize="14"
                                       TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Pagamento:"
                                       FontWeight="Bold"
                                       FontSize="14"/>

                            <TextBlock x:Name="TxtPagamento"
                                       Grid.Column="1"
                                       Text="Dinheiro"
                                       FontSize="14"
                                       TextAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="TxtCliente"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,15,0,12"/>

                        <!-- CABEÇALHO ITENS -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Produto"
                                       FontWeight="Bold"
                                       FontSize="13"/>

                            <TextBlock Grid.Column="1"
                                       Text="Qtd"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       TextAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="Subtotal"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       TextAlignment="Right"/>
                        </Grid>

                        <ItemsControl x:Name="ListaItens"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,15,0,15"/>

                        <!-- TOTAIS -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Subtotal:"
                                       FontSize="15"/>

                            <TextBlock x:Name="TxtSubtotal"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Desconto:"
                                       FontSize="15"/>

                            <TextBlock x:Name="TxtDesconto"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Valor recebido:"
                                       FontSize="15"/>

                            <TextBlock x:Name="TxtRecebido"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Troco:"
                                       FontSize="15"/>

                            <TextBlock x:Name="TxtTroco"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,8,0,12"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TOTAL:"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtTotal"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FF16A34A"/>
                        </Grid>

                        <TextBlock x:Name="TxtMensagemRodape"
                                   Text="Obrigado pela preferência!"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,15,0,5"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- BOTÕES -->
            <StackPanel Canvas.Left="510"
                        Canvas.Top="770"
                        Width="620"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="← Voltar para Vendas"
                        Width="190"
                        Height="50"
                        Background="#FF64748B"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoVoltar_Click"/>

                <Button Content="🧾 Histórico"
                        Width="160"
                        Height="50"
                        Margin="25,0,0,0"
                        Background="#FF7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoHistorico_Click"/>

                <Button Content="🖨 Imprimir"
                        Width="190"
                        Height="50"
                        Margin="25,0,0,0"
                        Background="#FF22C55E"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoImprimir_Click"/>
            </StackPanel>

        </Canvas>
    </Canvas>
</Page>