<Page x:Class="ProjetoIntegrador.TelaComprovante"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaComprovante">

    <Page.Resources>

        <!-- BOTÕES DO MENU LATERAL -->
        <Style x:Key="BotaoMenuStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.25"/>
                </Setter.Value>
            </Setter>

        </Style>

    </Page.Resources>

    <Canvas Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#FF0F172A">

        <!-- ================================================= -->
        <!-- FUNDO -->
        <!-- ================================================= -->

        <Rectangle Width="1920"
                   Height="1080">

            <Rectangle.Fill>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#FF0F172A"
                                  Offset="0"/>

                    <GradientStop Color="#FF1E293B"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->

        <Border Width="280"
                Height="1080"
                Background="#FF131111"
                CornerRadius="0,24,24,0">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>

            </Border.Effect>

            <Canvas>

                <!-- LOGO -->

                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       Width="250"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Canvas.Left="30"
                           Canvas.Top="130"
                           Fill="#33FFFFFF"/>

                <!-- ESTOQUE -->

                <Button x:Name="BotaoEstoque"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="📦 Estoque"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"/>

                <!-- VENDAS -->

                <Button x:Name="BotaoVendas"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="🛒 Vendas"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Click="BotaoVendas_Click"/>

                <!-- HISTÓRICO -->

                <Button x:Name="BotaoHistorico"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="🧾 Histórico"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"/>

                <!-- FINANCEIRO -->

                <Button x:Name="BotaoFinanceiro"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="💰 Financeiro"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"/>

                <!-- EMPRESA -->

                <Button x:Name="BotaoEmpresa"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="⚙️ Empresa"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Click="BotaoEmpresa_Click"/>

                <!-- CLIENTES -->

                <Button x:Name="BotaoClientes"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="👥 Clientes"
                        Canvas.Left="30"
                        Canvas.Top="523"
                        Click="BotaoClientes_Click"/>

                <!-- CARD CLIENTES -->

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="620"
                        Background="#FF181818"
                        CornerRadius="16"
                        BorderBrush="#FF404040"
                        BorderThickness="1.5">

                    <Canvas>

                        <Label Content="👥 Clientes"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Cadastro e&#x0a;gerenciamento"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>

                    </Canvas>

                </Border>

                <!-- SAIR -->

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="Red"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <Border Width="1640"
                Height="70"
                Canvas.Left="280"
                Background="#FF131111"
                BorderBrush="#FF404040"
                BorderThickness="0,0,0,1.5">

            <Canvas>

                <Label Content="Comprovante de Venda"
                       Canvas.Left="30"
                       Canvas.Top="15"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>

                <Label Content="Visualize e imprima o comprovante da venda"
                       Canvas.Left="32"
                       Canvas.Top="45"
                       FontSize="14"
                       Foreground="#FFD1D5DB"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ================================================= -->

        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Black">

            <!-- ================================================= -->
            <!-- COMPROVANTE -->
            <!-- ================================================= -->

            <Border x:Name="AreaComprovante"
                    Width="620"
                    Height="720"
                    Canvas.Left="510"
                    Canvas.Top="25"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="#FF505050"
                    BorderThickness="1.5">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>

                </Border.Effect>

                <ScrollViewer Background="White"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="35"
                                Background="White">

                        <!-- ================================================= -->
                        <!-- EMPRESA -->
                        <!-- ================================================= -->

                        <TextBlock x:Name="TxtEmpresa"
                                   Text="EMPRESA"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FF111827"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtRazaoSocial"
                                   Text="Razão Social"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtCnpj"
                                   Text="CNPJ:"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="TxtEndereco"
                                   Text="Endereço"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtContato"
                                   Text="Contato"
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,3,0,15"
                                   TextWrapping="Wrap"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,0,0,15"/>

                        <!-- ================================================= -->
                        <!-- DADOS DA VENDA -->
                        <!-- ================================================= -->

                        <TextBlock x:Name="TxtNumeroVenda"
                                   Text="Venda Nº 000000"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FF111827"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- DATA -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Data:"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtDataVenda"
                                       Grid.Column="1"
                                       Text="00/00/0000 00:00"
                                       FontSize="14"
                                       Foreground="#FF111827"
                                       TextAlignment="Right"/>

                        </Grid>

                        <!-- OPERADOR -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Operador:"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtOperador"
                                       Grid.Column="1"
                                       Text="Operador"
                                       FontSize="14"
                                       Foreground="#FF111827"
                                       TextAlignment="Right"/>

                        </Grid>

                        <!-- PAGAMENTO -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Pagamento:"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtPagamento"
                                       Grid.Column="1"
                                       Text="Dinheiro"
                                       FontSize="14"
                                       Foreground="#FF111827"
                                       TextAlignment="Right"/>

                        </Grid>

                        <!-- CLIENTE -->

                        <TextBlock x:Name="TxtCliente"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#FF374151"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,15,0,12"/>

                        <!-- ================================================= -->
                        <!-- CABEÇALHO DOS ITENS -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="95"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Produto"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#FF111827"/>

                            <TextBlock Grid.Column="1"
                                       Text="Qtd"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#FF111827"
                                       TextAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="Subtotal"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#FF111827"
                                       TextAlignment="Right"/>

                        </Grid>

                        <!-- ITENS -->

                        <ItemsControl x:Name="ListaItens"
                                      Foreground="#FF111827"/>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,15,0,15"/>

                        <!-- ================================================= -->
                        <!-- TOTAIS -->
                        <!-- ================================================= -->

                        <!-- SUBTOTAL -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Subtotal:"
                                       FontSize="15"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtSubtotal"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF111827"/>

                        </Grid>

                        <!-- DESCONTO -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Desconto:"
                                       FontSize="15"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtDesconto"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF111827"/>

                        </Grid>

                        <!-- VALOR RECEBIDO -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Valor recebido:"
                                       FontSize="15"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtRecebido"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF111827"/>

                        </Grid>

                        <!-- TROCO -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Troco:"
                                       FontSize="15"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtTroco"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF111827"/>

                        </Grid>

                        <Rectangle Height="1"
                                   Fill="#FFE5E7EB"
                                   Margin="0,8,0,12"/>

                        <!-- TOTAL -->

                        <Grid Margin="0,0,0,15">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TOTAL:"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FF111827"/>

                            <TextBlock x:Name="TxtTotal"
                                       Grid.Column="1"
                                       Text="R$ 0,00"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FF16A34A"/>

                        </Grid>

                        <!-- MENSAGEM DO RODAPÉ -->

                        <TextBlock x:Name="TxtMensagemRodape"
                                   Text="Obrigado pela preferência!"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF374151"
                                   TextAlignment="Center"
                                   Margin="0,15,0,5"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- ================================================= -->
            <!-- BOTÕES -->
            <!-- ================================================= -->

            <StackPanel Width="620"
                        Canvas.Left="510"
                        Canvas.Top="770"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="← Voltar para Vendas"
                        Width="190"
                        Height="50"
                        Background="#FF64748B"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoVoltar_Click"/>

                <Button Content="🧾 Histórico"
                        Width="160"
                        Height="50"
                        Margin="25,0,0,0"
                        Background="#FF7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoHistorico_Click"/>

                <Button Content="🖨 Imprimir"
                        Width="190"
                        Height="50"
                        Margin="25,0,0,0"
                        Background="#FF00FF5E"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="BotaoImprimir_Click"/>

            </StackPanel>

        </Canvas>

    </Canvas>

</Page>