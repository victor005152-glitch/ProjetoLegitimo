<Page x:Class="ProjetoIntegrador.TelaEmpresa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaEmpresa">

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- MENU LATERAL -->
        <Border Width="280"
                Height="1080"
                Background="#CC111827"
                CornerRadius="0,24,24,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"
                       Width="250"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Fill="#33FFFFFF"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                <Button x:Name="BotaoEstoque"
                        Content="📦 Estoque"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoVendas"
                        Content="🛒 Vendas"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Click="BotaoVendas_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro"
                        Content="   💰 Financeiro"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoEmpresa"
                        Content="⚙️ Empresa"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="570"
                        Background="#11FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1.5">

                    <Canvas>
                        <Label Content="⚙️ Configuração"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Dados usados no&#x0a;comprovante"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="#FFDC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                Width="1640"
                Height="70"
                Background="#11FFFFFF"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">

            <Canvas>
                <Label Content="Dados da Empresa"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Canvas.Left="30"
                       Canvas.Top="15"/>

                <Label Content="Essas informações aparecerão no comprovante de venda"
                       FontSize="14"
                       Foreground="#FFD1D5DB"
                       Canvas.Left="32"
                       Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Transparent">

            <Border Width="1590"
                    Height="780"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="24"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1.5">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.25"/>
                </Border.Effect>

                <Grid Margin="45,35,45,35">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO -->
                    <TextBlock Grid.Row="0"
                               Text="Cadastro da Empresa"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF0F172A"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="Preencha os dados da empresa para impressão no comprovante."
                               FontSize="16"
                               Foreground="#FF64748B"
                               Margin="0,0,0,30"/>

                    <!-- LINHA 1 -->
                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome Fantasia"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtNomeFantasia"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Razão Social"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtRazaoSocial"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 2 -->
                    <Grid Grid.Row="3"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CNPJ"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtCnpj"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefone"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtTelefone"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="E-mail"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtEmail"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 3 -->
                    <Grid Grid.Row="4"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Endereço"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtEndereco"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Número"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtNumero"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Bairro"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtBairro"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 4 -->
                    <Grid Grid.Row="5"
                          Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cidade"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtCidade"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UF"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtEstado"
                                         Margin="12,0"
                                         MaxLength="2"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CEP"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtCep"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Mensagem do rodapé"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#FF1E293B"
                                       Margin="0,0,0,6"/>

                            <Border Height="50"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1.5">

                                <TextBox x:Name="TxtMensagemRodape"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- BOTÕES -->
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="← Voltar"
                                Width="160"
                                Height="50"
                                Background="#FFEF4444"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Cursor="Hand"
                                Click="BotaoVoltar_Click"/>

                        <Button Content="💾 Salvar Dados"
                                Width="190"
                                Height="50"
                                Margin="25,0,0,0"
                                Background="#FF22C55E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Cursor="Hand"
                                Click="BotaoSalvar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>
    </Canvas>
</Page>