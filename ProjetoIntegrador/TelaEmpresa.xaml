<Page x:Class="ProjetoIntegrador.TelaEmpresa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaEmpresa">

    <!-- ================================================= -->
    <!-- ESTILOS -->
    <!-- ================================================= -->

    <Page.Resources>

        <!-- BOTÕES DO MENU -->
        <Style x:Key="BotaoMenuStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>

        </Style>

        <!-- TÍTULOS DOS CAMPOS -->
        <Style x:Key="RotuloCampoStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFD1D5DB"/>
            <Setter Property="Margin" Value="0,0,0,6"/>

        </Style>

        <!-- BORDA DOS CAMPOS -->
        <Style x:Key="BordaCampoStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#FF181818"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1.5"/>

        </Style>

        <!-- CAMPOS DE TEXTO -->
        <Style x:Key="CampoTextoStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#FF7C3AED"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

    </Page.Resources>

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <!-- ================================================= -->
        <!-- FUNDO -->
        <!-- ================================================= -->

        <Rectangle Width="1920"
                   Height="1080">

            <Rectangle.Fill>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#FF0F172A"
                                  Offset="0"/>

                    <GradientStop Color="#FF1E293B"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->

        <Border Width="280"
                Height="1080"
                Background="#FF131111"
                CornerRadius="0,24,24,0">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>

            </Border.Effect>

            <Canvas>

                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"
                       Width="250"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Fill="#33FFFFFF"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                <!-- ESTOQUE -->

                <Button x:Name="BotaoEstoque"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="📦 Estoque"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"/>

                <!-- VENDAS -->

                <Button x:Name="BotaoVendas"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="🛒 Vendas"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Click="BotaoVendas_Click"/>

                <!-- HISTÓRICO -->

                <Button x:Name="BotaoHistorico"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="🧾 Histórico"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"/>

                <!-- FINANCEIRO -->

                <Button x:Name="BotaoFinanceiro"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="   💰 Financeiro"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"/>

                <!-- EMPRESA -->

                <Button x:Name="BotaoEmpresa"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="⚙️ Empresa"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Background="#FF7C3AED"
                        BorderBrush="#FF9B6AF3" Click="BotaoEmpresa_Click"/>

                <!-- CLIENTES -->

                <Button x:Name="BotaoClientes"
                        Style="{StaticResource BotaoMenuStyle}"
                        Content="👥 Clientes"
                        Canvas.Left="30"
                        Canvas.Top="523"
                        Click="BotaoClientes_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"/>

                <!-- CARD PREMIUM -->

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="594"
                        Background="#11FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                    <Canvas>

                        <Label Content="⚡ WRV Premium"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Sistema moderno&#x0a;e otimizado"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>

                    </Canvas>

                </Border>

                <!-- SAIR -->

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="Red"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- TOPO -->
        <!-- ================================================= -->

        <Border Canvas.Left="280"
                Width="1640"
                Height="70"
                Background="#FF131111"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">

            <Canvas>

                <Label Content="Dados da Empresa"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Canvas.Left="30"
                       Canvas.Top="15"/>

                <Label Content="Essas informações aparecerão no comprovante de venda"
                       FontSize="14"
                       Foreground="#FFD1D5DB"
                       Canvas.Left="32"
                       Canvas.Top="45"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ================================================= -->

        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Black">

            <Border Width="1590"
                    Height="780"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#FF131111"
                    CornerRadius="24"
                    BorderBrush="#FF303030"
                    BorderThickness="1.5">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.25"/>

                </Border.Effect>

                <Grid Margin="45,35,45,35">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- ================================================= -->
                    <!-- TÍTULO -->
                    <!-- ================================================= -->

                    <TextBlock Grid.Row="0"
                               Text="Cadastro da Empresa"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="Preencha os dados da empresa para impressão no comprovante."
                               FontSize="16"
                               Foreground="#FFD1D5DB"
                               Margin="0,0,0,30"/>

                    <!-- ================================================= -->
                    <!-- LINHA 1 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- NOME FANTASIA -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Nome Fantasia"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtNomeFantasia"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- RAZÃO SOCIAL -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Razão Social"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtRazaoSocial"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- LINHA 2 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="3"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- CNPJ -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="CNPJ"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtCnpj"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- TELEFONE -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Telefone"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtTelefone"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- E-MAIL -->

                        <StackPanel Grid.Column="4">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="E-mail"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtEmail"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- LINHA 3 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- ENDEREÇO -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Endereço"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtEndereco"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- NÚMERO -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Número"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtNumero"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- BAIRRO -->

                        <StackPanel Grid.Column="4">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Bairro"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtBairro"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- LINHA 4 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="5"
                          Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="2*"/>

                        </Grid.ColumnDefinitions>

                        <!-- CIDADE -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Cidade"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtCidade"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- UF -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="UF"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtEstado"
                                         Style="{StaticResource CampoTextoStyle}"
                                         MaxLength="2"/>

                            </Border>

                        </StackPanel>

                        <!-- CEP -->

                        <StackPanel Grid.Column="4">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="CEP"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtCep"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                        <!-- MENSAGEM DO RODAPÉ -->

                        <StackPanel Grid.Column="6">

                            <TextBlock Style="{StaticResource RotuloCampoStyle}"
                                       Text="Mensagem do rodapé"/>

                            <Border Style="{StaticResource BordaCampoStyle}">

                                <TextBox x:Name="TxtMensagemRodape"
                                         Style="{StaticResource CampoTextoStyle}"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- BOTÕES -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="← Voltar"
                                Width="160"
                                Height="50"
                                Background="Red"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Cursor="Hand"
                                Click="BotaoVoltar_Click"/>

                        <Button Content="💾 Salvar Dados"
                                Width="190"
                                Height="50"
                                Margin="25,0,0,0"
                                Background="#FF00FF5E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Cursor="Hand"
                                Click="BotaoSalvar_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Canvas>

    </Canvas>

</Page>