                        Canvas.Top="245"
                        Click="BotaoVendas_Click_1"
                        Background="#FF1F2937"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <!-- Histórico -->

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <!-- Financeiro -->

                <Button x:Name="BotaoFinanceiro"
                        Content="💰 Financeiro"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <!-- Empresa -->

                <Button x:Name="BotaoEmpresa"
                        Content="⚙️ Empresa"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Click="Button_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <!-- Clientes -->

                <Button x:Name="BotaoClientes"
                        Content="👥 Clientes"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="523"
                        Click="BotaoClientes_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <!-- Card Premium -->

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="594"
                        Background="#11FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1.5"
                        CornerRadius="16">

                    <Canvas>

                        <Label Content="⚡ WRV Premium"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Sistema moderno&#x0a;e otimizado"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>

                    </Canvas>

                </Border>

                <!-- Sair -->

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Click="BotaoSair_Click"
                        Background="Red"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <Border Width="1640"
                Height="70"
                Canvas.Left="280"
                Background="#FF131111"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">

            <Canvas>

                <Label Content="Tela de Vendas"
                       Canvas.Left="30"
                       Canvas.Top="15"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>

                <Label Content="Consultar estoque e adicionar produtos ao carrinho"
                       Canvas.Left="32"
                       Canvas.Top="45"
                       FontSize="14"
                       Foreground="#FFD1D5DB"/>

            </Canvas>

        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ================================================= -->

        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Black">

            <!-- ================================================= -->
            <!-- PESQUISA -->
            <!-- ================================================= -->

            <Border Width="420"
                    Height="50"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#FF131111"
                    CornerRadius="12">

                <TextBox x:Name="PesquisaProduto"
                         Width="400"
                         Margin="10,0"
                         Padding="15"
                         Text="Código do produto..."
                         Background="#FF131111"
                         Foreground="White"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         GotFocus="PesquisaProduto_GotFocus"
                         LostFocus="PesquisaProduto_LostFocus"
                         KeyDown="PesquisaProduto_KeyDown"
                         TextChanged="PesquisaProduto_TextChanged"/>

            </Border>

            <!-- ================================================= -->
            <!-- QUANTIDADE -->
            <!-- ================================================= -->

            <Border Width="100"
                    Height="50"
                    Canvas.Left="465"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="12">

                <TextBox x:Name="QuantidadeVenda"
                         Width="80"
                         Margin="10,0"
                         Padding="10"
                         Text="1"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         FontSize="16"
                         FontWeight="Bold"/>

            </Border>

            <Label Content="QTD"
                   Canvas.Left="575"
                   Canvas.Top="35"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#FFD1D5DB"/>

            <!-- ================================================= -->
            <!-- ADICIONAR -->
            <!-- ================================================= -->

            <Button x:Name="BtnAdicionar"
                    Content="➕ Adicionar"
                    Width="170"
                    Height="50"
                    Canvas.Left="625"
                    Canvas.Top="25"
                    Click="BtnAdicionar_Click"
                    Background="#FF00B342"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="16"
                    Cursor="Hand"/>

            <!-- ================================================= -->
            <!-- CLIENTE -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- CLIENTE -->
            <!-- ================================================= -->

            <Border Width="280"
        Height="50"
        Canvas.Left="815"
        Canvas.Top="25"
        Background="#FF131111"
        BorderBrush="#FF404040"
        BorderThickness="1"
        CornerRadius="12">

                <Grid>

                    <ComboBox x:Name="ComboClientes"
                  Style="{StaticResource ComboBoxEscuroStyle}"
                  Width="260"
                  Height="34"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  SelectionChanged="ComboClientes_SelectionChanged"/>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- DATAGRID DE ESTOQUE -->
            <!-- ================================================= -->

            <Border Width="520"
                    Height="430"
                    Canvas.Left="25"
                    Canvas.Top="100"
                    Background="#FF131111"
                    CornerRadius="20">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>

                </Border.Effect>

                <Canvas>

                    <Label Content="📦 Consultar Estoque"
                           Canvas.Left="18"
                           Canvas.Top="8"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <Label Content="Duplo clique para adicionar"
                           Canvas.Left="300"
                           Canvas.Top="15"
                           FontSize="13"
                           Foreground="White"/>

                    <DataGrid x:Name="DGEstoque"
                              Style="{StaticResource DataGridEscuroStyle}"
                              ColumnHeaderStyle="{StaticResource CabecalhoDataGridEscuroStyle}"
                              RowStyle="{StaticResource LinhaDataGridEscuroStyle}"
                              CellStyle="{StaticResource CelulaDataGridEscuroStyle}"
                              Canvas.Left="10"
                              Canvas.Top="50"
                              Width="500"
                              Height="360"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FontSize="13"
                              RowHeight="32"
                              MouseDoubleClick="DGEstoque_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Width="95"
                                                Binding="{Binding CodigoBarras}"/>

                            <DataGridTextColumn Header="Produto"
                                                Width="185"
                                                Binding="{Binding Nome}"/>

                            <DataGridTextColumn Header="Categoria"
                                                Width="100"
                                                Binding="{Binding Categoria}"/>

                            <DataGridTextColumn Header="Estoque"
                                                Width="65"
                                                Binding="{Binding QuantidadeEstoque}"/>

                            <DataGridTextColumn Header="Valor"
                                                Width="80"
                                                Binding="{Binding ValorVenda,
                                                                  StringFormat={}{0:C2}}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- DATAGRID DO CARRINHO -->
            <!-- ================================================= -->

            <Border Width="520"
                    Height="430"
                    Canvas.Left="560"
                    Canvas.Top="100"
                    Background="#FF131111"
                    CornerRadius="20">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>

                </Border.Effect>

                <Canvas>

                    <Label Content="🛒 Carrinho"
                           Canvas.Left="18"
                           Canvas.Top="8"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <DataGrid x:Name="DGVendas"
                              Style="{StaticResource DataGridEscuroStyle}"
                              ColumnHeaderStyle="{StaticResource CabecalhoDataGridEscuroStyle}"
                              RowStyle="{StaticResource LinhaDataGridEscuroStyle}"
                              CellStyle="{StaticResource CelulaDataGridEscuroStyle}"
                              Canvas.Left="10"
                              Canvas.Top="50"
                              Width="500"
                              Height="360"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FontSize="13"
                              RowHeight="32">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Width="95"
                                                Binding="{Binding CodigoBarras}"/>

                            <DataGridTextColumn Header="Produto"
                                                Width="180"
                                                Binding="{Binding Nome}"/>

                            <DataGridTextColumn Header="QTD"
                                                Width="55"
                                                Binding="{Binding Quantidade}"/>

                            <DataGridTextColumn Header="Valor"
                                                Width="80"
                                                Binding="{Binding ValorUnitario,
                                                                  StringFormat={}{0:C2}}"/>

                            <DataGridTextColumn Header="Desc."
                                                Width="70"
                                                Binding="{Binding Desconto,
                                                                  StringFormat={}{0:C2}}"/>

                            <DataGridTextColumn Header="Subtotal"
                                                Width="90"
                                                Binding="{Binding Subtotal,
                                                                  StringFormat={}{0:C2}}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- BOTÕES DO CARRINHO -->
            <!-- ================================================= -->

            <Button x:Name="BtnRemoverItem"
                    Content="🗑 Remover Item"
                    Width="180"
                    Height="45"
                    Canvas.Left="640"
                    Canvas.Top="550"
                    Click="BtnRemoverItem_Click"
                    Background="Red"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand"/>

            <Button x:Name="BtnLimparVenda"
                    Content="🧹 Limpar Tudo"
                    Width="180"
                    Height="45"
                    Canvas.Left="829"
                    Canvas.Top="550"
                    Click="BtnLimparVenda_Click"
                    Background="#FFFF9800"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand"/>

            <!-- ================================================= -->
            <!-- CARD DE ITENS -->
            <!-- ================================================= -->

            <Border Width="240"
                    Height="95"
                    Canvas.Left="25"
                    Canvas.Top="550"
                    Background="#FF131111"
                    CornerRadius="20">

                <Canvas>

                    <Label Content="🛒 Itens"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <Label x:Name="TotalItens"
                           Content="0"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FF7C3AED"/>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- CARD TOTAL -->
            <!-- ================================================= -->

            <Border Width="260"
                    Height="95"
                    Canvas.Left="285"
                    Canvas.Top="550"
                    Background="#FF131111"
                    CornerRadius="20">

                <Canvas>

                    <Label Content="💰 Total"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <Label x:Name="ValorTotalVenda"
                           Content="R$ 0,00"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF22C55E"/>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- RESUMO DA VENDA -->
            <!-- ================================================= -->

            <Border Width="490"
                    Height="665"
                    Canvas.Left="1110"
                    Canvas.Top="25"
                    Background="#FF131111"
                    CornerRadius="20">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>

                </Border.Effect>

                <Canvas>

                    <Label Content="RESUMO DA VENDA"
                           Canvas.Left="30"
                           Canvas.Top="20"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <Rectangle Width="430"
                               Height="1.5"
                               Canvas.Left="30"
                               Canvas.Top="60"
                               Fill="#FFE5E7EB"/>

                    <!-- Subtotal -->

                    <Label Content="Subtotal:"
                           Canvas.Left="30"
                           Canvas.Top="80"
                           FontSize="16"
                           Foreground="White"/>

                    <Label x:Name="LabelSubtotal"
                           Content="R$ 0,00"
                           Canvas.Left="280"
                           Canvas.Top="80"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <!-- Desconto -->

                    <Label Content="Desconto: (%)"
                           Canvas.Left="30"
