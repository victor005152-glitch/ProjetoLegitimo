<Page x:Class="ProjetoIntegrador.TelaVendas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="Tela de Vendas">

    <!-- ================================================= -->
    <!-- ESTILOS -->
    <!-- ================================================= -->

    <Page.Resources>
        <Style x:Key="ComboBoxEscuroStyle"
       TargetType="{x:Type ComboBox}">

            <Setter Property="Background" Value="#FF131111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MaxDropDownHeight" Value="250"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <!-- Itens da lista aberta -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>

                    <Style TargetType="{x:Type ComboBoxItem}">

                        <Setter Property="Background" Value="#FF131111"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF252525"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF7C3AED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>
            </Setter>

            <!-- Template completo do ComboBox -->
            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <!-- Parte fechada do ComboBox -->
                            <ToggleButton x:Name="BotaoCombo"
                                  Background="{TemplateBinding Background}"
                                  Foreground="{TemplateBinding Foreground}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen,
                                                      Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                                        <Border x:Name="Borda"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Texto selecionado -->
                                                <ContentPresenter Grid.Column="0"
                                                          Margin="10,0,5,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{Binding SelectionBoxItem,
                                                                            RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                          ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                                    RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat,
                                                                                        RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>

                                                <!-- Seta -->
                                                <Border Grid.Column="1"
                                                Background="#FF181818"
                                                BorderBrush="#FF404040"
                                                BorderThickness="1,0,0,0">

                                                    <Path Width="9"
                                                  Height="5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="White"
                                                  Data="M 0 0 L 4.5 5 L 9 0 Z"/>

                                                </Border>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Borda"
                                                Property="Background"
                                                Value="#FF252525"/>
                                                <Setter TargetName="Borda"
                                                Property="BorderBrush"
                                                Value="#FF707070"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Borda"
                                                Property="BorderBrush"
                                                Value="#FF7C3AED"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <!-- Lista aberta -->
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade"
                           IsOpen="{TemplateBinding IsDropDownOpen}">

                                <Border MinWidth="{Binding ActualWidth,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,3,0,0"
                                Background="#FF131111"
                                BorderBrush="#FF404040"
                                BorderThickness="1"
                                CornerRadius="4">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- DataGrid principal -->
        <Style x:Key="DataGridEscuroStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#FF131111"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="#FF131111"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FF181818"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="All"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#FF404040"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#FF404040"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="AlternationCount"
                    Value="2"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <!-- Cabeçalho dos DataGrids -->
        <Style x:Key="CabecalhoDataGridEscuroStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#FF131111"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Setter Property="BorderBrush"
                    Value="#FF707070"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Linhas dos DataGrids -->
        <Style x:Key="LinhaDataGridEscuroStyle"
               TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="#FF131111"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#FF404040"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#FF181818"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF252525"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF7C3AED"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Células dos DataGrids -->
        <Style x:Key="CelulaDataGridEscuroStyle"
               TargetType="DataGridCell">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#FF404040"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF7C3AED"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="BorderBrush"
                            Value="#FF9B6AF3"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Page.Resources>

    <Canvas Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#FF0F172A">

        <!-- ================================================= -->
        <!-- FUNDO -->
        <!-- ================================================= -->

        <Rectangle Width="1920"
                   Height="1080">

            <Rectangle.Fill>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#FF0F172A"
                                  Offset="0"/>

                    <GradientStop Color="#FF1E293B"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->

