<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="ProjetoIntegrador.TelaVendas"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="Tela de Vendas">

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- MENU LATERAL -->
        <Border Width="280"
                Height="1080"
                Background="#CC111827"
                CornerRadius="0,24,24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"
                       Width="250"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Fill="#33FFFFFF"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                <Button x:Name="BotaoEstoque"
                        Content="📦 Estoque"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>
                <Button x:Name="BotaoClientes"
Content="👥 Clientes"
Width="220"
Height="48"
Canvas.Left="30"
Canvas.Top="523"
Click="BotaoClientes_Click"
Background="#FF1F2937"
Foreground="White"
BorderThickness="0"
FontSize="16"
FontWeight="Bold"
Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Top"/>


                <Button x:Name="BotaoVendas"
                        Content="🛒 Vendas"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Click="BotaoHistorico_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro"
                        Content="   💰 Financeiro"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoEmpresa"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand" Click="Button_Click" Content="⚙️ Empresa"/>

                 <Border Width="220"
             Height="100"
             Canvas.Left="30"
            Canvas.Top="594"
             Background="#11FFFFFF"
             CornerRadius="16"
             BorderBrush="#22FFFFFF"
             BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Canvas>
                        <Label Content="⚡ WRV Premium"
                    Canvas.Left="18"
                    Canvas.Top="15"
                    FontWeight="Bold"
                    FontSize="16"
                    Foreground="White"/>
                        <Label Content="Sistema moderno&#x0a;e otimizado"
                    Canvas.Left="18"
                    Canvas.Top="45"
                    FontSize="13"
                    Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="#FFDC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                Width="1640"
                Height="70"
                Background="#11FFFFFF"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">
            <Canvas>
                <Label Content="Tela de Vendas"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Canvas.Left="30"
                       Canvas.Top="15"/>

                <Label Content="Consultar estoque e adicionar produtos ao carrinho"
                       FontSize="14"
                       Foreground="#FFD1D5DB"
                       Canvas.Left="32"
                       Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Transparent">

            <!-- PESQUISA -->
            <Border Width="420"
                    Height="50"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="12">

                <TextBox x:Name="PesquisaProduto"
                         Width="400"
                         Text="Código do produto..."
                         Padding="15"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         GotFocus="PesquisaProduto_GotFocus"
                         LostFocus="PesquisaProduto_LostFocus"
                         KeyDown="PesquisaProduto_KeyDown"
                         TextChanged="PesquisaProduto_TextChanged"
                         Margin="10,0,10,0"/>
            </Border>

            <!-- QUANTIDADE -->
            <Border Width="100"
                    Height="50"
                    Canvas.Left="465"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="12">

                <TextBox x:Name="QuantidadeVenda"
                         Width="80"
                         Text="1"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         FontSize="16"
                         FontWeight="Bold"
                         Margin="10,0,10,0"/>
            </Border>

            <Label Content="QTD"
                   Canvas.Left="575"
                   Canvas.Top="35"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#FFD1D5DB"/>

            <!-- BOTÃO ADICIONAR -->
            <Button x:Name="BtnAdicionar"
                    Content="➕ Adicionar"
                    Width="170"
                    Height="50"
                    Canvas.Left="625"
                    Canvas.Top="25"
                    Click="BtnAdicionar_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="16"
                    Cursor="Hand"/>
            <!-- CLIENTE -->
            <Border Width="280"
        Height="50"
        Canvas.Left="815"
        Canvas.Top="25"
        Background="#CCFFFFFF"
        CornerRadius="12">

                <Canvas>
                    <ComboBox x:Name="ComboClientes"
                  Width="260"
                  Height="34"
                  Canvas.Left="10"
                  Canvas.Top="8"
                  FontSize="14"
                  SelectionChanged="ComboClientes_SelectionChanged"/>
                </Canvas>
            </Border>

            <!-- DATAGRID ESTOQUE -->
            <Border Width="520"
                    Height="430"
                    Canvas.Left="25"
                    Canvas.Top="100"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Border.Effect>

                <Canvas>
                    <Label Content="📦 Consultar Estoque"
                           Canvas.Left="18"
                           Canvas.Top="8"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label Content="Duplo clique para adicionar"
                           Canvas.Left="300"
                           Canvas.Top="15"
                           FontSize="13"
                           Foreground="#FF6B7280"/>

                    <DataGrid x:Name="DGEstoque"
                              Canvas.Left="10"
                              Canvas.Top="50"
                              Width="500"
                              Height="360"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              MouseDoubleClick="DGEstoque_MouseDoubleClick"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="13"
                              RowHeight="32">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                                Width="95"
                                                Binding="{Binding CodigoBarras}"/>

                            <DataGridTextColumn Header="Produto"
                                                Width="185"
                                                Binding="{Binding Nome}"/>

                            <DataGridTextColumn Header="Categoria"
                                                Width="100"
                                                Binding="{Binding Categoria}"/>

                            <DataGridTextColumn Header="Estoque"
                                                Width="65"
                                                Binding="{Binding QuantidadeEstoque}"/>

                            <DataGridTextColumn Header="Valor"
                                                Width="80"
                                                Binding="{Binding ValorVenda, StringFormat={}{0:C2}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Canvas>
            </Border>

            <!-- DATAGRID CARRINHO -->
            <Border Width="520"
                    Height="430"
                    Canvas.Left="560"
                    Canvas.Top="100"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Border.Effect>

                <Canvas>
                    <Label Content="🛒 Carrinho"
                           Canvas.Left="18"
                           Canvas.Top="8"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <DataGrid x:Name="DGVendas"
                              Canvas.Left="10"
                              Canvas.Top="50"
                              Width="500"
                              Height="360"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="13"
                              RowHeight="32">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                                Width="95"
                                                Binding="{Binding CodigoBarras}"/>

                            <DataGridTextColumn Header="Produto"
                                                Width="180"
                                                Binding="{Binding Nome}"/>

                            <DataGridTextColumn Header="QTD"
                                                Width="55"
                                                Binding="{Binding Quantidade}"/>

                            <DataGridTextColumn Header="Valor"
                                                Width="80"
                                                Binding="{Binding ValorUnitario, StringFormat={}{0:C2}}"/>

                            <DataGridTextColumn Header="Desc."
                                                Width="70"
                                                Binding="{Binding Desconto, StringFormat={}{0:C2}}"/>

                            <DataGridTextColumn Header="Subtotal"
                                                Width="90"
                                                Binding="{Binding Subtotal, StringFormat={}{0:C2}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Canvas>
            </Border>

            <!-- BOTÕES DO CARRINHO -->
            <Button x:Name="BtnRemoverItem"
                    Content="🗑 Remover Item"
                    Width="180"
                    Height="45"
                    Canvas.Left="640"
                    Canvas.Top="550"
                    Click="BtnRemoverItem_Click"
                    Background="#FFEF4444"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Button x:Name="BtnLimparVenda"
                    Content="🧹 Limpar Tudo"
                    Width="180"
                    Height="45"
                    Canvas.Left="829"
                    Canvas.Top="550"
                    Click="BtnLimparVenda_Click"
                    Background="#FFF59E0B"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- CARD ITENS -->
            <Border Width="240"
                    Height="95"
                    Canvas.Left="25"
                    Canvas.Top="550"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="🛒 Itens"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="TotalItens"
                           Content="0"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FF7C3AED"/>
                </Canvas>
            </Border>

            <!-- CARD TOTAL -->
            <Border Width="260"
                    Height="95"
                    Canvas.Left="285"
                    Canvas.Top="550"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="💰 Total"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="ValorTotalVenda"
                           Content="R$ 0,00"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF22C55E"/>
                </Canvas>
            </Border>

            <!-- CARD RESUMO DA VENDA -->
            <Border Width="490"
                    Height="665"
                    Canvas.Left="1110"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Border.Effect>

                <Canvas>
                    <Label Content="RESUMO DA VENDA"
                           Canvas.Left="30"
                           Canvas.Top="20"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Rectangle Width="430"
                               Height="1.5"
                               Fill="#FFE5E7EB"
                               Canvas.Left="30"
                               Canvas.Top="60"/>

                    <!-- SUBTOTAL -->
                    <Label Content="Subtotal:"
                           Canvas.Left="30"
                           Canvas.Top="80"
                           FontSize="16"
                           Foreground="#FF6B7280"/>

                    <Label x:Name="LabelSubtotal"
                           Content="R$ 0,00"
                           Canvas.Left="280"
                           Canvas.Top="80"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <!-- DESCONTO -->
                    <Label Content="Desconto: (%)"
                           Canvas.Left="30"
                           Canvas.Top="130"
                           FontSize="16"
                           Foreground="#FF6B7280"/>

                    <Border Width="150"
                            Height="40"
                            Canvas.Left="280"
                            Canvas.Top="125"
                            Background="#FFF3F4F6"
                            CornerRadius="10">

                        <TextBox x:Name="DescontoGeral"
                                 Width="130"
                                 Padding="10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Margin="10,0,10,0"
                                 TextChanged="DescontoGeral_TextChanged"/>
                    </Border>

                    <Label Content="%"
                           Canvas.Left="407"
                           Canvas.Top="131"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FF1E293B" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <Rectangle Width="430"
                               Height="1.5"
                               Fill="#FFE5E7EB"
                               Canvas.Left="30"
                               Canvas.Top="185"/>

                    <!-- TOTAL -->
                    <Label Content="TOTAL:"
                           Canvas.Left="30"
                           Canvas.Top="210"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="LabelTotal"
                           Content="R$ 0,00"
                           Canvas.Left="200"
                           Canvas.Top="210"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF22C55E"/>

                    <Rectangle Width="430"
                               Height="2"
                               Fill="#FF22C55E"
                               Canvas.Left="30"
                               Canvas.Top="260"/>

                    <!-- PAGAMENTO -->
                    <Label Content="FORMA DE PAGAMENTO"
                           Canvas.Left="30"
                           Canvas.Top="280"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Button x:Name="BtnDinheiro"
                            Content="💵 Dinheiro"
                            Width="195"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="330"
                            Click="BtnDinheiro_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                    <Button x:Name="BtnCartao"
                            Content="💳 Cartão"
                            Width="195"
                            Height="50"
                            Canvas.Left="240"
                            Canvas.Top="330"
                            Click="BtnCartao_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                    <Button x:Name="BtnPix"
                            Content="📱 Pix"
                            Width="195"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="395"
                            Click="BtnPix_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                    <Button x:Name="BtnBoleto"
                            Content="📄 Boleto"
                            Width="195"
                            Height="50"
                            Canvas.Left="240"
                            Canvas.Top="395"
                            Click="BtnBoleto_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                    <Label x:Name="LabelPagamento"
                           Content="Pagamento: Dinheiro"
                           Canvas.Left="30"
                           Canvas.Top="465"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FF3B82F6"/>

                    <!-- VALOR RECEBIDO -->
                    <Label Content="Valor Recebido:"
                           Canvas.Left="30"
                           Canvas.Top="500"
                           FontSize="14"
                           Foreground="#FF6B7280"/>

                    <Border Width="180"
                            Height="40"
                            Canvas.Left="160"
                            Canvas.Top="495"
                            Background="#FFF3F4F6"
                            CornerRadius="10">

                        <TextBox x:Name="ValorRecebido"
                                 Width="160"
                                 Padding="10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Margin="10,0,10,0"
                                 TextChanged="ValorRecebido_TextChanged"/>
                    </Border>

                    <!-- TROCO -->
                    <Label Content="Troco:"
                           Canvas.Left="30"
                           Canvas.Top="545"
                           FontSize="16"
                           Foreground="#FF6B7280"/>

                    <Label x:Name="LabelTroco"
                           Content="R$ 0,00"
                           Canvas.Left="280"
                           Canvas.Top="545"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFEF4444"/>

                    <!-- FINALIZAR -->
                    <Button x:Name="BtnFinalizar"
                            Content="✅ FINALIZAR VENDA"
                            Width="430"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="600"
                            Click="BtnFinalizar_Click"
                            Background="#FF22C55E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="18"
                            Cursor="Hand"/>
                </Canvas>
            </Border>
        </Canvas>
    </Canvas>
</Page>