<Page x:Class="ProjetoIntegrador.TelaVendas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Tela de Vendas">

    <Canvas Background="#FF0F172A" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->
        <Border Width="280"
                    Height="1080"
                    Background="#CC111827"
                    CornerRadius="0,24,24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <!-- LOGO -->
                <Label Content="WRV CONTROL"
                           Canvas.Left="15"
                           Canvas.Top="45"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="White"/>
                <Label Content="Sistema Inteligente"
                           Canvas.Left="25"
                           Canvas.Top="90"
                           FontSize="15"
                           Foreground="#FF9CA3AF"/>

                <!-- LINHA -->
                <Rectangle Width="220"
                             Height="1.5"
                             Fill="#33FFFFFF"
                             Canvas.Left="30"
                             Canvas.Top="130"/>

                <!-- BOTÕES DO MENU -->
                <Button x:Name="BotaoEstoque"
                            Content="📦 Estoque"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="175"
                            Click="BotaoEstoque_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="BotaoVendas"
                            Content="🛒 Vendas"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="250"
                            Background="#FF3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="BotaoHistorico"
                            Content="🧾 Histórico"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="325"
                            Click="BotaoHistorico_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro" 
                            Content="💰 Financeiro"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="400"
                            Click="BotaoFinanceiro_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                <!-- CARD INFO -->
                <Border Width="220"
                            Height="100"
                            Canvas.Left="30"
                            Canvas.Top="520"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">
                    <Canvas>
                        <Label Content="⚡ WRV Premium"
                                   Canvas.Left="18"
                                   Canvas.Top="15"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="White"/>
                        <Label Content="Sistema moderno&#x0a;e otimizado"
                                   Canvas.Left="18"
                                   Canvas.Top="45"
                                   FontSize="13"
                                   Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <!-- BOTÃO SAIR -->
                <Button Content="🚪 Sair"
                            Width="220"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="975"
                            Click="BotaoSair_Click"
                            Background="#FFDC2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                    Width="1640"
                    Height="70"
                    Background="#11FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1.5">
            <Canvas>
                <Label Content="Tela de Vendas"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Canvas.Left="30"
                           Canvas.Top="15"/>
                <Label Content="Frente de Caixa - PDV"
                           FontSize="14"
                           Foreground="#FFD1D5DB"
                           Canvas.Left="32"
                           Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL - VENDAS -->
        <!-- ================================================= -->
        <Canvas Width="1640"
                    Height="1010"
                    Canvas.Left="280"
                    Canvas.Top="70"
                    Background="Transparent">

            <!-- ================================================= -->
            <!-- LADO ESQUERDO - LISTA DE PRODUTOS -->
            <!-- ================================================= -->

            <!-- CAMPO DE PESQUISA DO PRODUTO -->
            <Border Width="400"
                        Height="50"
                        Canvas.Left="25"
                        Canvas.Top="25"
                        Background="#CCFFFFFF"
                        CornerRadius="12">
                <TextBox x:Name="PesquisaProduto" 
                             Width="380"
                             Text="Código ou nome do produto..."
                             Padding="15"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="15"
                             GotFocus="PesquisaProduto_GotFocus"
                             LostFocus="PesquisaProduto_LostFocus"
                             KeyDown="PesquisaProduto_KeyDown"
                             Margin="10,0,10,0"/>
            </Border>

            <!-- BOTÃO ADICIONAR -->
            <Button x:Name="BtnAdicionar"
                        Content="➕ Adicionar"
                        Width="180"
                        Height="50"
                        Canvas.Left="440"
                        Canvas.Top="25"
                        Click="BtnAdicionar_Click"
                        Background="#FF22C55E"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="12"
                                        ShadowDepth="0"
                                        Opacity="0.25"/>
                </Button.Effect>
            </Button>

            <!-- QUANTIDADE -->
            <Border Width="100"
                        Height="50"
                        Canvas.Left="640"
                        Canvas.Top="25"
                        Background="#CCFFFFFF"
                        CornerRadius="12">
                <TextBox x:Name="QuantidadeVenda" 
                             Width="80"
                             Text="1"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             FontSize="16"
                             FontWeight="Bold"
                             Margin="10,0,10,0"/>
            </Border>

            <Label Content="QTD:"
                       Canvas.Left="750"
                       Canvas.Top="35"
                       FontSize="14"
                       Foreground="#FFD1D5DB"/>

            <!-- TABELA DE PRODUTOS DA VENDA -->
            <Border Width="1050"
                        Height="420"
                        Canvas.Left="25"
                        Canvas.Top="100"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                        ShadowDepth="0"
                                        Opacity="0.15"/>
                </Border.Effect>

                <DataGrid x:Name="DGVendas" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="14"
                              RowHeight="35"
                              Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                              Width="120"
                                              Binding="{Binding CodigoBarras}"/>
                        <DataGridTextColumn Header="Produto"
                                              Width="250"
                                              Binding="{Binding Nome}"/>
                        <DataGridTextColumn Header="QTD"
                                              Width="80"
                                              Binding="{Binding Quantidade}"/>
                        <DataGridTextColumn Header="Valor Un."
                                              Width="120"
                                              Binding="{Binding ValorUnitario, StringFormat=R$ {0:N2}}"/>
                        <DataGridTextColumn Header="Desconto"
                                              Width="100"
                                              Binding="{Binding Desconto, StringFormat=R$ {0:N2}}"/>
                        <DataGridTextColumn Header="Subtotal"
                                              Width="130"
                                              Binding="{Binding Subtotal, StringFormat=R$ {0:N2}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- BOTÕES DE AÇÃO NOS ITENS -->
            <Button x:Name="BtnRemoverItem"
                        Content="🗑 Remover Item"
                        Width="180"
                        Height="45"
                        Canvas.Left="25"
                        Canvas.Top="540"
                        Click="BtnRemoverItem_Click"
                        Background="#FFEF4444"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"/>

            <Button x:Name="BtnLimparVenda"
                        Content="🧹 Limpar Tudo"
                        Width="180"
                        Height="45"
                        Canvas.Left="220"
                        Canvas.Top="540"
                        Click="BtnLimparVenda_Click"
                        Background="#FFF59E0B"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"/>

            <!-- ================================================= -->
            <!-- LADO DIREITO - RESUMO DA VENDA -->
            <!-- ================================================= -->

            <!-- CARD RESUMO -->
            <Border Width="490"
                        Height="620"
                        Canvas.Left="1110"
                        Canvas.Top="25"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                        ShadowDepth="0"
                                        Opacity="0.15"/>
                </Border.Effect>

                <Canvas>
                    <Label Content="RESUMO DA VENDA"
                               Canvas.Left="30"
                               Canvas.Top="20"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>

                    <Rectangle Width="430"
                                 Height="1.5"
                                 Fill="#FFE5E7EB"
                                 Canvas.Left="30"
                                 Canvas.Top="60"/>

                    <!-- SUBTOTAL -->
                    <Label Content="Subtotal:"
                               Canvas.Left="30"
                               Canvas.Top="80"
                               FontSize="16"
                               Foreground="#FF6B7280"/>
                    <Label x:Name="LabelSubtotal"
                               Content="R$ 0,00"
                               Canvas.Left="280"
                               Canvas.Top="80"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"
                               HorizontalAlignment="Right"/>

                    <!-- DESCONTO -->
                    <Label Content="Desconto:"
                               Canvas.Left="30"
                               Canvas.Top="130"
                               FontSize="16"
                               Foreground="#FF6B7280"/>

                    <Border Width="150"
                                Height="40"
                                Canvas.Left="280"
                                Canvas.Top="125"
                                Background="#FFF3F4F6"
                                CornerRadius="10">
                        <TextBox x:Name="DescontoGeral" 
                                     Width="130"
                                     Text="0,00"
                                     Padding="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Margin="10,0,10,0"
                                     TextChanged="DescontoGeral_TextChanged"/>
                    </Border>

                    <Rectangle Width="430"
                                 Height="1.5"
                                 Fill="#FFE5E7EB"
                                 Canvas.Left="30"
                                 Canvas.Top="185"/>

                    <!-- TOTAL -->
                    <Label Content="TOTAL:"
                               Canvas.Left="30"
                               Canvas.Top="210"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                    <Label x:Name="LabelTotal"
                               Content="R$ 0,00"
                               Canvas.Left="200"
                               Canvas.Top="210"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FF22C55E"
                               HorizontalAlignment="Right"/>

                    <Rectangle Width="430"
                                 Height="2"
                                 Fill="#FF22C55E"
                                 Canvas.Left="30"
                                 Canvas.Top="260"/>

                    <!-- FORMA DE PAGAMENTO -->
                    <Label Content="FORMA DE PAGAMENTO"
                               Canvas.Left="30"
                               Canvas.Top="280"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>

                    <!-- OPÇÕES DE PAGAMENTO -->
                    <Button x:Name="BtnDinheiro"
                                Content="💵 Dinheiro"
                                Width="195"
                                Height="50"
                                Canvas.Left="30"
                                Canvas.Top="330"
                                Click="BtnDinheiro_Click"
                                Background="#FF1F2937"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="16"
                                Cursor="Hand"/>

                    <Button x:Name="BtnCartao"
                                Content="💳 Cartão"
                                Width="195"
                                Height="50"
                                Canvas.Left="240"
                                Canvas.Top="330"
                                Click="BtnCartao_Click"
                                Background="#FF1F2937"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="16"
                                Cursor="Hand"/>

                    <Button x:Name="BtnPix"
                                Content="📱 Pix"
                                Width="195"
                                Height="50"
                                Canvas.Left="30"
                                Canvas.Top="395"
                                Click="BtnPix_Click"
                                Background="#FF1F2937"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="16"
                                Cursor="Hand"/>

                    <Button x:Name="BtnBoleto"
                                Content="📄 Boleto"
                                Width="195"
                                Height="50"
                                Canvas.Left="240"
                                Canvas.Top="395"
                                Click="BtnBoleto_Click"
                                Background="#FF1F2937"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="16"
                                Cursor="Hand"/>

                    <!-- PAGAMENTO SELECIONADO -->
                    <Label x:Name="LabelPagamento"
                               Content="Pagamento: Dinheiro"
                               Canvas.Left="30"
                               Canvas.Top="465"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF3B82F6"/>

                    <!-- VALOR RECEBIDO -->
                    <Label Content="Valor Recebido:"
                               Canvas.Left="30"
                               Canvas.Top="500"
                               FontSize="14"
                               Foreground="#FF6B7280"/>

                    <Border Width="180"
                                Height="40"
                                Canvas.Left="160"
                                Canvas.Top="495"
                                Background="#FFF3F4F6"
                                CornerRadius="10">
                        <TextBox x:Name="ValorRecebido" 
                                     Width="160"
                                     Text="0,00"
                                     Padding="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Margin="10,0,10,0"
                                     TextChanged="ValorRecebido_TextChanged"/>
                    </Border>

                    <!-- TROCO -->
                    <Label Content="Troco:"
                               Canvas.Left="30"
                               Canvas.Top="545"
                               FontSize="16"
                               Foreground="#FF6B7280"/>
                    <Label x:Name="LabelTroco"
                               Content="R$ 0,00"
                               Canvas.Left="280"
                               Canvas.Top="545"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFEF4444"
                               HorizontalAlignment="Right"/>

                    <!-- BOTÃO FINALIZAR -->
                    <Button x:Name="BtnFinalizar"
                                Content="✅ FINALIZAR VENDA"
                                Width="430"
                                Height="55"
                                Canvas.Left="30"
                                Canvas.Top="600"
                                Click="BtnFinalizar_Click"
                                Background="#FF22C55E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="18"
                                Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="15"
                                                ShadowDepth="0"
                                                Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </Canvas>
            </Border>

            <!-- CARD ITENS E VALOR -->
            <Border Width="260"
                        Height="95"
                        Canvas.Left="25"
                        Canvas.Top="600"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Canvas>
                    <Label Content="🛒 Itens"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                    <Label x:Name="TotalItens" 
                               Content="0"
                               Canvas.Left="22"
                               Canvas.Top="45"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF7C3AED"/>
                </Canvas>
            </Border>

            <Border Width="260"
                        Height="95"
                        Canvas.Left="310"
                        Canvas.Top="600"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Canvas>
                    <Label Content="💰 Total"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                    <Label x:Name="ValorTotalVenda" 
                               Content="R$ 0,00"
                               Canvas.Left="22"
                               Canvas.Top="45"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF22C55E"/>
                </Canvas>
            </Border>

        </Canvas>
    </Canvas>
</Page>