                Height="1080"
                Background="#FF131111"
                CornerRadius="0,24,24,0">

            <Border.Effect>

                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>

            </Border.Effect>

            <Canvas>

                <!-- Logo -->

                <Label Content="WRV CONTROL"
