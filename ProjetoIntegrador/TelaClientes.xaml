<Page x:Class="ProjetoIntegrador.TelaClientes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TelaClientes">

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <Border Width="280"
                Height="1080"
                Canvas.Left="0"
                Canvas.Top="0"
                Background="#FF111827">


            <!-- MENU LATERAL -->
            <Border Width="280"
        Visibility="Visible"
        Height="1080"
        Background="#CC111827"
        CornerRadius="0,24,24,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.25"/>
                </Border.Effect>

                <Canvas>
                    <!-- LOGO -->
                    <Label Content="WRV CONTROL"
               Canvas.Left="15"
               Canvas.Top="45"
               FontWeight="Bold"
               FontSize="32"
               Foreground="White"
               HorizontalAlignment="Center"
               Height="55"
               VerticalAlignment="Top"
               Width="250"/>

                    <Label Content="Sistema Inteligente"
               Canvas.Left="25"
               Canvas.Top="90"
               FontSize="15"
               Foreground="#FF9CA3AF"/>

                    <!-- LINHA -->
                    <Rectangle Width="220"
                   Height="1.5"
                   Fill="#33FFFFFF"
                   Canvas.Left="30"
                   Canvas.Top="130"/>

                    <!-- BOTÃO ESTOQUE -->
                    <Button x:Name="BotaoEstoque"
                Content="📦 Estoque"
                Width="220"
                Height="55"
                Canvas.Left="30"
                Canvas.Top="175"
                Click="IrEstoque_Click"
                Background="#FF1F2937"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- BOTÃO VENDAS -->
                    <Button x:Name="BotaoVendas"
                Content="🛒 Vendas"
                Width="220"
                Height="55"
                Canvas.Left="30"
                Canvas.Top="245"
                Click="IrVendas_Click"
                Background="#FF1F2937"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- BOTÃO CLIENTES -->
                    <Button x:Name="BotaoClientes"
                Content="👥 Clientes"
                Width="220"
                Height="55"
                Canvas.Left="30"
               Canvas.Top="523"
                Click="BotaoClientes_Click"
                Background="#FF7C3AED"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- BOTÃO HISTÓRICO -->
                    <Button x:Name="BotaoHistorico"
                Content="🧾 Histórico"
                Width="220"
                Height="55"
                Canvas.Left="30"
                Canvas.Top="315"
                Click="IrHistorico_Click"
                Background="#FF1F2937"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- BOTÃO FINANCEIRO -->
                    <Button x:Name="BotaoFinanceiro"
                Content="   💰 Financeiro"
                Width="220"
                Height="55"
                Canvas.Left="30"
                  Canvas.Top="385"
                Click="IrFinanceiro_Click"
                Background="#FF1F2937"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- BOTÃO EMPRESA -->
                    <Button x:Name="BotaoEmpresa"
                Content="⚙️ Empresa"
                Width="220"
                Height="55"
                Canvas.Left="30"
               Canvas.Top="455"
                Click="IrEmpresa_Click"
                Background="#FF1F2937"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <!-- CARD INFO -->
                    <Border Width="220"
 Height="100"
 Canvas.Left="30"
Canvas.Top="594"
 Background="#11FFFFFF"
 CornerRadius="16"
 BorderBrush="#22FFFFFF"
 BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Canvas>
                            <Label Content="⚡ WRV Premium"
        Canvas.Left="18"
        Canvas.Top="15"
        FontWeight="Bold"
        FontSize="16"
        Foreground="White"/>
                            <Label Content="Sistema moderno&#x0a;e otimizado"
        Canvas.Left="18"
        Canvas.Top="45"
        FontSize="13"
        Foreground="#FFD1D5DB"/>
                        </Canvas>
                    </Border>

                    <!-- BOTÃO SAIR -->
                    <Button Content="🚪 Sair"
                Width="220"
                Height="50"
                Canvas.Left="30"
                Canvas.Top="975"
                Background="#FFDC2626"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="16"
                Cursor="Hand"
                Click="Sair_Click"/>
                </Canvas>
            </Border>
        </Border>

        <Border Width="1640"
                Height="70"
                Canvas.Left="280"
                Canvas.Top="0"
                Background="#FF1E293B">

            <Canvas>
                <Label Content="Cadastro de Clientes"
                       Canvas.Left="30"
                       Canvas.Top="13"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

                <Label Content="Cadastre, pesquise e gerencie os clientes da loja"
                       Canvas.Left="1220"
                       Canvas.Top="22"
                       FontSize="15"
                       Foreground="#FFCBD5E1"/>
            </Canvas>
        </Border>

        <Canvas Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70">

            <Border Width="620"
                    Height="940"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="Dados do Cliente"
                           Canvas.Left="25"
                           Canvas.Top="20"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label Content="Nome"
                           Canvas.Left="25"
                           Canvas.Top="75"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtNome"
                             Width="560"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="105"
                             FontSize="15"/>

                    <Label Content="CPF"
                           Canvas.Left="25"
                           Canvas.Top="150"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtCpf"
                             Width="260"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="180"
                             FontSize="15"/>

                    <Label Content="Telefone"
                           Canvas.Left="315"
                           Canvas.Top="150"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtTelefone"
                             Width="270"
                             Height="38"
                             Canvas.Left="315"
                             Canvas.Top="180"
                             FontSize="15"/>

                    <Label Content="E-mail"
                           Canvas.Left="25"
                           Canvas.Top="225"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtEmail"
                             Width="560"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="255"
                             FontSize="15"/>

                    <Label Content="Endereço"
                           Canvas.Left="25"
                           Canvas.Top="300"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtEndereco"
                             Width="390"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="330"
                             FontSize="15"/>

                    <Label Content="Número"
                           Canvas.Left="440"
                           Canvas.Top="300"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtNumero"
                             Width="145"
                             Height="38"
                             Canvas.Left="440"
                             Canvas.Top="330"
                             FontSize="15"/>

                    <Label Content="Bairro"
                           Canvas.Left="25"
                           Canvas.Top="375"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtBairro"
                             Width="260"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="405"
                             FontSize="15"/>

                    <Label Content="Cidade"
                           Canvas.Left="315"
                           Canvas.Top="375"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtCidade"
                             Width="270"
                             Height="38"
                             Canvas.Left="315"
                             Canvas.Top="405"
                             FontSize="15"/>

                    <Label Content="UF"
                           Canvas.Left="25"
                           Canvas.Top="450"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtEstado"
                             Width="90"
                             Height="38"
                             Canvas.Left="25"
                             Canvas.Top="480"
                             FontSize="15"
                             MaxLength="2"/>

                    <Label Content="CEP"
                           Canvas.Left="145"
                           Canvas.Top="450"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtCep"
                             Width="200"
                             Height="38"
                             Canvas.Left="145"
                             Canvas.Top="480"
                             FontSize="15"/>

                    <Label Content="Observação"
                           Canvas.Left="25"
                           Canvas.Top="525"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF374151"/>

                    <TextBox x:Name="TxtObservacao"
                             Width="560"
                             Height="95"
                             Canvas.Left="25"
                             Canvas.Top="555"
                             FontSize="15"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <Button Content="💾 Salvar Cliente"
                            Width="560"
                            Height="50"
                            Canvas.Left="25"
                            Canvas.Top="690"
                            Click="BotaoSalvar_Click"
                            Background="#FF22C55E"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <Button Content="🧹 Novo / Limpar"
                            Width="270"
                            Height="46"
                            Canvas.Left="25"
                            Canvas.Top="755"
                            Click="BotaoNovo_Click"
                            Background="#FF3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <Button Content="🗑 Excluir Cliente"
                            Width="270"
                            Height="46"
                            Canvas.Left="315"
                            Canvas.Top="755"
                            Click="BotaoExcluir_Click"
                            Background="#FFDC2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <Label x:Name="LabelIdCliente"
                           Content="Nenhum cliente selecionado"
                           Canvas.Left="25"
                           Canvas.Top="830"
                           Width="560"
                           FontSize="14"
                           Foreground="#FF64748B"/>
                </Canvas>
            </Border>

            <Border Width="945"
                    Height="940"
                    Canvas.Left="670"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="Lista de Clientes"
                           Canvas.Left="25"
                           Canvas.Top="20"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <TextBox x:Name="TxtPesquisa"
                             Width="620"
                             Height="40"
                             Canvas.Left="25"
                             Canvas.Top="75"
                             FontSize="15"
                             KeyDown="TxtPesquisa_KeyDown"/>

                    <Button Content="🔎 Pesquisar"
                            Width="250"
                            Height="40"
                            Canvas.Left="670"
                            Canvas.Top="75"
                            Click="BotaoPesquisar_Click"
                            Background="#FF7C3AED"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <DataGrid x:Name="Clientes1"
                              Width="895"
                              Height="770"
                              Canvas.Left="25"
                              Canvas.Top="140"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="Clientes1_SelectionChanged"
                              FontSize="14"
                              RowHeight="38"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="White"
                              BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Width="60"
                                                Binding="{Binding Id}"/>

                            <DataGridTextColumn Header="Nome"
                                                Width="260"
                                                Binding="{Binding Nome}"/>

                            <DataGridTextColumn Header="CPF"
                                                Width="140"
                                                Binding="{Binding Cpf}"/>

                            <DataGridTextColumn Header="Telefone"
                                                Width="150"
                                                Binding="{Binding Telefone}"/>

                            <DataGridTextColumn Header="Cidade"
                                                Width="160"
                                                Binding="{Binding Cidade}"/>

                            <DataGridTextColumn Header="UF"
                                                Width="70"
                                                Binding="{Binding Estado}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Canvas>
            </Border>
        </Canvas>
    </Canvas>
</Page>