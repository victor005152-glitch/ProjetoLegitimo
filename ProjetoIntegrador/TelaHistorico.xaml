<Page x:Class="ProjetoIntegrador.TelaHistorico"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="TelaHistorico">
    <Canvas Background="#FF0F172A" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->
        <Border Width="280"
                    Visibility="Visible"
                    Height="1080"
                    Background="#CC111827"
                    CornerRadius="0,24,24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <!-- LOGO -->
                <Label Content="WRV CONTROL"
                           Canvas.Left="15"
                           Canvas.Top="45"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Height="55" 
                           VerticalAlignment="Top" 
                           Width="250"/>

                <Label Content="Sistema Inteligente"
                           Canvas.Left="25"
                           Canvas.Top="90"
                           FontSize="15"
                           Foreground="#FF9CA3AF"/>

                <!-- LINHA -->
                <Rectangle Width="220"
                             Height="1.5"
                             Fill="#33FFFFFF"
                             Canvas.Left="30"
                             Canvas.Top="130"/>

                <!-- BOTÕES DO MENU -->
                <Button x:Name="BotaoEstoque"
                            Content="📦 Estoque"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="175"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="BotaoEstoque_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>

                <!-- NOVO BOTÃO VENDAS -->
                <Button x:Name="BotaoVendas"
                            Content="🛒 Vendas"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="245"
                            Click="BotaoVendas_Click"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="BotaoHistorico"
                            Content="🧾 Histórico"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="315"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro" 
                            Content="💰 Financeiro"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="385"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="Button_Click"/>

                <!-- CARD INFO -->
                <Border Width="220"
                            Height="100"
                            Canvas.Left="30"
                            Canvas.Top="500"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">
                    <Canvas>
                        <Label Content="⚡ WRV Premium"
                                   Canvas.Left="18"
                                   Canvas.Top="15"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="White"/>
                        <Label Content="Sistema moderno&#x0a;e otimizado"
                                   Canvas.Left="18"
                                   Canvas.Top="45"
                                   FontSize="13"
                                   Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <!-- BOTÃO SAIR -->
                <Button Content="🚪 Sair"
                            Width="220"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="975"
                            Background="#FFDC2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="Button_Click_1"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                    Visibility="Visible"
                    Width="1640"
                    Height="70"
                    Background="#11FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1.5">
            <Canvas>
                <Label Content="Sistema de Controle"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Canvas.Left="30"
                           Canvas.Top="15"/>
                <Label Content="Gerenciamento inteligente"
                           FontSize="14"
                           Foreground="#FFD1D5DB"
                           Canvas.Left="32"
                           Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL - HISTÓRICO DE VENDAS -->
        <!-- ================================================= -->
        <Canvas x:Name="HistDeVendas"
                    Visibility="Visible"
                    Width="1640"
                    Height="1010"
                    Canvas.Left="280"
                    Canvas.Top="70"
                    Background="Transparent">

            <!-- CAMPO DE PESQUISA -->
            <Border Width="260"
                        Height="45"
                        Canvas.Left="1355"
                        Canvas.Top="70"
                        Background="#CCFFFFFF"
                        CornerRadius="12">
                <TextBox x:Name="Pesquisa" 
                             Width="240"
                             Text="Pesquisar..."
                             Padding="12"
                             BorderThickness="0"
                             GotFocus="Pesquisa_GotFocus"
                             LostFocus="Pesquisa_LostFocus"            
                             Background="Transparent"
                             VerticalContentAlignment="Center" 
                             Margin="10,2,10,0"
                             FontSize="15"/>
            </Border>

            <!-- BOTÃO COMPROVANTE -->
            <Button x:Name="Comprovante"
                        Content="📄 Comprovante"
                        Width="180"
                        Height="45"
                        Canvas.Left="25"
                        Canvas.Top="25"
                 
                        Background="#FF3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="12"
                                        ShadowDepth="0"
                                        Opacity="0.25"/>
                </Button.Effect>
            </Button>

            <!-- CARDS DE RESUMO (ADICIONAIS) -->
            <Border Width="280"
                        Height="90"
                        Canvas.Left="230"
                        Canvas.Top="25"
                        Background="#CCFFFFFF"
                        CornerRadius="16">
                <Canvas>
                    <Label Content="📊 Total de Vendas"
                               Canvas.Left="20"
                               Canvas.Top="10"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                    <Label x:Name="TotalVendas" 
                               Content="156"
                               Canvas.Left="22"
                               Canvas.Top="42"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FF7C3AED"/>
                </Canvas>
            </Border>

            <Border Width="280"
                        Height="90"
                        Canvas.Left="535"
                        Canvas.Top="25"
                        Background="#CCFFFFFF"
                        CornerRadius="16">
                <Canvas>
                    <Label Content="💰 Valor Total"
                               Canvas.Left="20"
                               Canvas.Top="10"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                    <Label x:Name="ValorTotal" 
                               Content="R$ 12.450,00"
                               Canvas.Left="22"
                               Canvas.Top="42"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FF22C55E"/>
                </Canvas>
            </Border>

            <!-- TABELA DE HISTÓRICO -->
            <Border Width="1590"
                        Height="420"
                        Canvas.Left="25"
                        Canvas.Top="135"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                        ShadowDepth="0"
                                        Opacity="0.15"/>
                </Border.Effect>

                <DataGrid x:Name="Historico1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent"
                              HeadersVisibility="Column"
                              FontSize="14"
                              RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                              Width="150"
                                              Binding="{Binding Codigo}"/>

                        <DataGridTextColumn Header="Qtd"
                                              Width="100"
                                              Binding="{Binding Qtd}"/>

                        <DataGridTextColumn Header="Descrição"
                                              Width="280"
                                              Binding="{Binding Descricao}"/>

                        <DataGridTextColumn Header="Valor"
                                              Width="180"
                                              Binding="{Binding Valor}"/>

                        <DataGridTextColumn Header="Data"
                                              Width="180"
                                              Binding="{Binding Data, StringFormat=dd/MM/yyyy}"/>

                        <DataGridTextColumn Header="Cliente"
                                              Width="250"
                                              Binding="{Binding Cliente}"/>

                        <DataGridTextColumn Header="CPF"
                                              Width="200"
                                              Binding="{Binding CPF}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- SEÇÃO DE DETALHES (OPCIONAL) -->
            <Border Width="1590"
                        Height="180"
                        Canvas.Left="25"
                        Canvas.Top="575"
                        Background="#11FFFFFF"
                        CornerRadius="20"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1">
                <Canvas>
                    <Label Content="📋 Detalhes da Venda Selecionada"
                               Canvas.Left="25"
                               Canvas.Top="15"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <Label Content="Selecione uma venda na tabela acima para ver mais detalhes"
                               Canvas.Left="25"
                               Canvas.Top="50"
                               FontSize="14"
                               Foreground="#FFD1D5DB"/>

                    <!-- INFORMAÇÕES DETALHADAS -->
                    <StackPanel Canvas.Left="25" Canvas.Top="85" Orientation="Horizontal">
                        <Border Width="350"
                                    Height="70"
                                    Background="#11FFFFFF"
                                    CornerRadius="12"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,15,0">
                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="Produto"
                                               FontSize="13"
                                               Foreground="#FF9CA3AF"/>
                                <TextBlock x:Name="DetalheProduto"
                                               Text="-"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Width="350"
                                    Height="70"
                                    Background="#11FFFFFF"
                                    CornerRadius="12"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,15,0">
                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="Cliente"
                                               FontSize="13"
                                               Foreground="#FF9CA3AF"/>
                                <TextBlock x:Name="DetalheCliente"
                                               Text="-"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Width="350"
                                    Height="70"
                                    Background="#11FFFFFF"
                                    CornerRadius="12"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,15,0">
                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="Valor Total"
                                               FontSize="13"
                                               Foreground="#FF9CA3AF"/>
                                <TextBlock x:Name="DetalheValor"
                                               Text="-"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Width="350"
                                    Height="70"
                                    Background="#11FFFFFF"
                                    CornerRadius="12"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="Data"
                                               FontSize="13"
                                               Foreground="#FF9CA3AF"/>
                                <TextBlock x:Name="DetalheData"
                                               Text="-"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Canvas>
            </Border>
        </Canvas>
    </Canvas>
</Page>