<Page x:Class="ProjetoIntegrador.TelaHistorico"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaHistorico">

    <Canvas Background="#FF0F172A"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- MENU LATERAL -->
        <Border Width="280"
                Height="1080"
                Background="#CC111827"
                CornerRadius="0,24,24,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <Label Content="WRV CONTROL"
                       Canvas.Left="15"
                       Canvas.Top="45"
                       FontWeight="Bold"
                       FontSize="32"
                       Foreground="White"
                       Width="250"/>

                <Label Content="Sistema Inteligente"
                       Canvas.Left="25"
                       Canvas.Top="90"
                       FontSize="15"
                       Foreground="#FF9CA3AF"/>

                <Rectangle Width="220"
                           Height="1.5"
                           Fill="#33FFFFFF"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                <Button x:Name="BotaoEstoque"
                        Content="📦 Estoque"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="175"
                        Click="BotaoEstoque_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoVendas"
                        Content="🛒 Vendas"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="245"
                        Click="BotaoVendas_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="315"
                        Background="#FF7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro"
                        Content="   💰 Financeiro"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="385"
                        Click="BotaoFinanceiro_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Button x:Name="BotaoEmpresa"
                        Content="⚙️ Empresa"
                        Width="220"
                        Height="55"
                        Canvas.Left="30"
                        Canvas.Top="455"
                        Click="BotaoEmpresa_Click"
                        Background="#FF1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"/>

                <Border Width="220"
                        Height="100"
                        Canvas.Left="30"
                        Canvas.Top="570"
                        Background="#11FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1.5">
                    <Canvas>
                        <Label Content="🧾 Histórico"
                               Canvas.Left="18"
                               Canvas.Top="15"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                        <Label Content="Consulte vendas&#x0a;e comprovantes"
                               Canvas.Left="18"
                               Canvas.Top="45"
                               FontSize="13"
                               Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <Button Content="🚪 Sair"
                        Width="220"
                        Height="50"
                        Canvas.Left="30"
                        Canvas.Top="975"
                        Background="#FFDC2626"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BotaoSair_Click"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                Width="1640"
                Height="70"
                Background="#11FFFFFF"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1.5">

            <Canvas>
                <Label Content="Histórico de Vendas"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Canvas.Left="30"
                       Canvas.Top="15"/>

                <Label Content="Consulte vendas finalizadas e reimprima comprovantes"
                       FontSize="14"
                       Foreground="#FFD1D5DB"
                       Canvas.Left="32"
                       Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Canvas x:Name="HistDeVendas"
                Width="1640"
                Height="1010"
                Canvas.Left="280"
                Canvas.Top="70"
                Background="Transparent">

            <!-- CARDS -->
            <Border Width="260"
                    Height="95"
                    Canvas.Left="25"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="🧾 Vendas"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="TotalVendas"
                           Content="0"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FF7C3AED"/>
                </Canvas>
            </Border>

            <Border Width="320"
                    Height="95"
                    Canvas.Left="310"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="💰 Valor Total"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="ValorTotal"
                           Content="R$ 0,00"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#FF22C55E"/>
                </Canvas>
            </Border>

            <Border Width="320"
                    Height="95"
                    Canvas.Left="655"
                    Canvas.Top="25"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Canvas>
                    <Label Content="📦 Itens Vendidos"
                           Canvas.Left="20"
                           Canvas.Top="12"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Label x:Name="TotalItens"
                           Content="0"
                           Canvas.Left="22"
                           Canvas.Top="45"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FF3B82F6"/>
                </Canvas>
            </Border>

            <!-- PESQUISA -->
            <Border Width="360"
                    Height="45"
                    Canvas.Left="1245"
                    Canvas.Top="145"
                    Background="#CCFFFFFF"
                    CornerRadius="12">

                <TextBox x:Name="Pesquisa"
                         Width="340"
                         Text="Pesquisar venda..."
                         Padding="12"
                         BorderThickness="0"
                         GotFocus="Pesquisa_GotFocus"
                         LostFocus="Pesquisa_LostFocus"
                         TextChanged="Pesquisa_TextChanged"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"/>
            </Border>

            <Button x:Name="BtnComprovante"
                    Content="🖨 Abrir Comprovante"
                    Width="210"
                    Height="45"
                    Canvas.Left="25"
                    Canvas.Top="145"
                    Click="BtnComprovante_Click"
                    Background="#FF7C3AED"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand"/>

            <Button Content="🔄 Atualizar"
                    Width="150"
                    Height="45"
                    Canvas.Left="260"
                    Canvas.Top="145"
                    Click="BotaoAtualizar_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand"/>

            <!-- TABELA HISTÓRICO -->
            <Border Width="1160"
                    Height="640"
                    Canvas.Left="25"
                    Canvas.Top="210"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Border.Effect>

                <DataGrid x:Name="Historico1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          FontSize="14"
                          RowHeight="38"
                          SelectionChanged="Historico1_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Venda"
                                            Width="90"
                                            Binding="{Binding CodigoVenda}"/>

                        <DataGridTextColumn Header="Data"
                                            Width="160"
                                            Binding="{Binding DataFormatada}"/>

                        <DataGridTextColumn Header="Cliente"
                                            Width="180"
                                            Binding="{Binding Cliente}"/>

                        <DataGridTextColumn Header="Pagamento"
                                            Width="130"
                                            Binding="{Binding FormaPagamento}"/>

                        <DataGridTextColumn Header="Itens"
                                            Width="80"
                                            Binding="{Binding QuantidadeItens}"/>

                        <DataGridTextColumn Header="Total"
                                            Width="130"
                                            Binding="{Binding TotalFormatado}"/>

                        <DataGridTextColumn Header="Operador"
                                            Width="150"
                                            Binding="{Binding Operador}"/>

                        <DataGridTextColumn Header="Produtos"
                                            Width="*"
                                            Binding="{Binding Produtos}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- DETALHES -->
            <Border Width="390"
                    Height="640"
                    Canvas.Left="1215"
                    Canvas.Top="210"
                    Background="#CCFFFFFF"
                    CornerRadius="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Border.Effect>

                <Canvas>
                    <Label Content="Detalhes da Venda"
                           Canvas.Left="25"
                           Canvas.Top="20"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF1E293B"/>

                    <Rectangle Width="330"
                               Height="1.5"
                               Fill="#FFE5E7EB"
                               Canvas.Left="30"
                               Canvas.Top="70"/>

                    <Label Content="Venda"
                           Canvas.Left="25"
                           Canvas.Top="95"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <Label x:Name="DetalheVenda"
                           Content="Selecione uma venda"
                           Canvas.Left="25"
                           Canvas.Top="120"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#FF111827"
                           Width="330"/>

                    <Label Content="Produtos"
                           Canvas.Left="25"
                           Canvas.Top="170"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <TextBlock x:Name="DetalheProduto"
                               Text="-"
                               Canvas.Left="30"
                               Canvas.Top="200"
                               FontSize="15"
                               Foreground="#FF111827"
                               Width="330"
                               Height="120"
                               TextWrapping="Wrap"/>

                    <Label Content="Cliente"
                           Canvas.Left="25"
                           Canvas.Top="330"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <Label x:Name="DetalheCliente"
                           Content="-"
                           Canvas.Left="25"
                           Canvas.Top="355"
                           FontSize="16"
                           Foreground="#FF111827"
                           Width="330"/>

                    <Label Content="Valor"
                           Canvas.Left="25"
                           Canvas.Top="405"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <Label x:Name="DetalheValor"
                           Content="R$ 0,00"
                           Canvas.Left="25"
                           Canvas.Top="430"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF22C55E"
                           Width="330"/>

                    <Label Content="Data"
                           Canvas.Left="25"
                           Canvas.Top="490"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <Label x:Name="DetalheData"
                           Content="-"
                           Canvas.Left="25"
                           Canvas.Top="515"
                           FontSize="16"
                           Foreground="#FF111827"
                           Width="330"/>

                    <Label Content="Pagamento"
                           Canvas.Left="25"
                           Canvas.Top="560"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF64748B"/>

                    <Label x:Name="DetalhePagamento"
                           Content="-"
                           Canvas.Left="25"
                           Canvas.Top="585"
                           FontSize="16"
                           Foreground="#FF111827"
                           Width="330"/>
                </Canvas>
            </Border>
        </Canvas>
    </Canvas>
</Page>