<Page x:Class="ProjetoIntegrador.TelaHistorico"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TelaHistorico">
    <Viewbox Stretch="Uniform">
        <Canvas Background="#FF0F172A" Width="800" Height="450" HorizontalAlignment="Left" VerticalAlignment="Center" >

            <!-- FUNDO -->
            <Rectangle Width="800"
           Height="450">

                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0F172A" Offset="0"/>
                        <GradientStop Color="#FF1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>

            </Rectangle>

            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <Border Width="185"
        Visibility="Visible"
        Height="450"
        Background="#CC111827"
        CornerRadius="0,18,18,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.20"/>
                </Border.Effect>

                <Canvas>

                    <!-- LOGO -->
                    <Label Content="WRV CONTROL"
               Canvas.Left="1"
               Canvas.Top="25"
               FontWeight="Bold"
               FontSize="24"
               Foreground="White" HorizontalAlignment="Center" Height="45" VerticalAlignment="Top" Width="184"/>

                    <Label Content="Sistema Inteligente"
               Canvas.Left="18"
               Canvas.Top="58"
               FontSize="11"
               Foreground="#FF9CA3AF"/>

                    <!-- LINHA -->
                    <Rectangle Width="145"
                   Height="1"
                   Fill="#22FFFFFF"
                   Canvas.Left="20"
                   Canvas.Top="90"/>

                    <!-- BOTÕES -->

                    <Button x:Name="BotaoEstoque"
                Content="📦 Estoque"
                Width="145"
                Height="42"
                Canvas.Left="20"
                Canvas.Top="120"
                Background="#FF7C3AED"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="13"
                Cursor="Hand" Click="BotaoEstoque_Click">

                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.20"/>
                        </Button.Effect>

                    </Button>

                    <Button x:Name="BotaoHistorico"
                Content="🧾 Histórico"
                Width="145"
                Height="42"
                Canvas.Left="20"
                Canvas.Top="175"
                Background="#FF1F2937"
                Foreground="White"
                BorderBrush="#223B82F6"
                FontWeight="Bold"
                FontSize="13"
                Cursor="Hand"/>

                    <Button Content="💰 Financeiro"
                Width="145"
                Height="42"
                Canvas.Left="20"
                Canvas.Top="230"
                Background="#FF1F2937"
                Foreground="White"
                BorderBrush="#223B82F6"
                FontWeight="Bold"
                FontSize="13"
                Cursor="Hand" Click="Button_Click"/>

                    <!-- CARD INFO -->
                    <Border Width="145"
                Height="72"
                Canvas.Left="20"
                Canvas.Top="305"
                Background="#11FFFFFF"
                CornerRadius="14"
                BorderBrush="#22FFFFFF"
                BorderThickness="1">

                        <Canvas>

                            <Label Content="⚡ WRV Premium"
                       Canvas.Left="12"
                       Canvas.Top="10"
                       FontWeight="Bold"
                       FontSize="13"
                       Foreground="White"/>

                            <Label Content="Sistema moderno&#x0a;e otimizado"
                       Canvas.Left="12"
                       Canvas.Top="33"
                       FontSize="11"
                       Foreground="#FFD1D5DB"/>

                        </Canvas>

                    </Border>

                    <!-- SAIR -->
                    <Button Content="🚪 Sair"
                Width="145"
                Height="40"
                Canvas.Left="20"
                Canvas.Top="392"
                Background="#FFDC2626"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="13"
                Cursor="Hand" Click="Button_Click_1"/>

                </Canvas>

            </Border>

            <!-- TOPO -->
            <Border Canvas.Left="185"
        Visibility="Visible"
        Width="615"
        Height="56"
        Background="#11FFFFFF"
        BorderBrush="#22FFFFFF"
        BorderThickness="0,0,0,1">

                <Canvas>

                    <Label Content="Sistema de Controle"
               FontSize="20"
               FontWeight="Bold"
               Foreground="White"
               Canvas.Left="20"
               Canvas.Top="13"/>

                    <Label Content="Gerenciamento inteligente"
               FontSize="11"
               Foreground="#FFD1D5DB"
               Canvas.Left="22"
               Canvas.Top="35"/>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- HISTÓRICO -->
            <!-- ================================================= -->

            <Canvas x:Name="HistDeVendas"
        Visibility="Visible"
        Width="615"
        Height="394"
        Canvas.Left="185"
        Canvas.Top="56"
        Background="Transparent">

                <Border Width="180"
            Height="34"
            Canvas.Left="420"
            Canvas.Top="15"
            Background="#CCFFFFFF"
            CornerRadius="10">

                    <TextBox x:Name="Pesquisa" Width="160"
                 Text="Pesquisar..."
                 Padding="8"
                 BorderThickness="0"
                 GotFocus="Pesquisa_GotFocus"
                 LostFocus="Pesquisa_LostFocus"            
                 Background="Transparent"
                 VerticalContentAlignment="Center" Margin="10,2,10,0"
                             />


                </Border>

                <Button x:Name="Comprovante"
            Content="📄 Comprovante"
            Width="140"
            Height="36"
            Canvas.Left="15"
            Canvas.Top="15"
            Background="#FF3B82F6"
            Foreground="White"
            BorderThickness="0"
            FontWeight="Bold"
            Cursor="Hand">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.20"/>
                    </Button.Effect>

                </Button>

                <Border Width="585"
            Height="320"
            Canvas.Left="15"
            Canvas.Top="60"
            Background="#CCFFFFFF"
            CornerRadius="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.10"/>
                    </Border.Effect>

                    <DataGrid x:Name="Historico1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  BorderThickness="0"
                  Background="Transparent"
                  HeadersVisibility="Column">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                    Binding="{Binding Codigo}"/>

                            <DataGridTextColumn Header="Qtd"
                                    Binding="{Binding Qtd}"/>

                            <DataGridTextColumn Header="Descrição"
                                    Binding="{Binding Descricao}"/>

                            <DataGridTextColumn Header="Valor"
                                    Binding="{Binding Valor}"/>

                            <DataGridTextColumn Header="Data"
                                    Binding="{Binding Data, StringFormat=dd/MM/yyyy}"/>

                            <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding Cliente}"/>

                            <DataGridTextColumn Header="CPF"
                                    Binding="{Binding CPF}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Canvas>

        </Canvas>
        
    </Viewbox>
</Page>
