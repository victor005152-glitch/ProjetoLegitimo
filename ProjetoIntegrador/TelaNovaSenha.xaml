<Page x:Class="ProjetoIntegrador.TelaNovaSenha"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaNovaSenha"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Width="1920"
          Height="1080"
          Background="#FF0F172A"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">

        <!-- FUNDO COM GRADIENTE -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- ELEMENTOS DECORATIVOS -->
            <Ellipse Width="450"
                     Height="450"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-150,-120,0,0"
                     Fill="#227C3AED"
                     RenderOptions.BitmapScalingMode="HighQuality"/>

            <Ellipse Width="350"
                     Height="350"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-70,-70"
                     Fill="#223B82F6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>

            <Ellipse Width="280"
                     Height="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Margin="650,0,0,0"
                     Fill="#113B82F6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <!-- GRID PRINCIPAL -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="580"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO -->
            <Grid Grid.Column="0">
                <StackPanel Margin="120,120,0,0"
                            VerticalAlignment="Top">

                    <TextBlock Text="WRV Control"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="White"
                               TextOptions.TextFormattingMode="Display"
                               Width="326"/>

                    <TextBlock Text="Gerencie usuários, estoque e controle seu sistema com facilidade."
                               Margin="0,30,0,0"
                               FontSize="24"
                               Foreground="#FFD1D5DB"
                               TextWrapping="Wrap"
                               MaxWidth="500"
                               TextOptions.TextFormattingMode="Display"
                               Width="392"/>

                    <!-- CARD 1 -->
                    <Border Width="380"
                            Height="90"
                            Margin="0,100,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="🔒 Login Seguro"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Proteção avançada dos dados"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2 -->
                    <Border Width="380"
                            Height="90"
                            Margin="0,25,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="⚡ Sistema Rápido"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Interface moderna e fluida"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3 -->
                    <Border Width="380"
                            Height="90"
                            Margin="0,25,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="🔑 Nova Senha"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Defina uma nova senha com segurança"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CARD NOVA SENHA -->
            <Grid Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Width="500"
                        Height="600"
                        Background="#CCFFFFFF"
                        CornerRadius="24"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1.5"
                        Margin="-250,-10,250,10">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35"
                                          ShadowDepth="0"
                                          Opacity="0.35"
                                          RenderingBias="Quality"/>
                    </Border.Effect>

                    <Grid Margin="55,35,55,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->
                        <TextBlock Text="Nova Senha"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="Black"/>

                        <TextBlock Text="Digite e confirme sua nova senha"
                                   Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   FontSize="18"
                                   Foreground="#FF64748B"/>

                        <!-- NOVA SENHA -->
                        <TextBlock Text="Nova senha"
                                   Grid.Row="2"
                                   Margin="0,35,0,8"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#FF1E293B"/>

                        <Border Grid.Row="3"
                                Height="55"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1.5">

                            <PasswordBox x:Name="NovaSenhaDigitada"
                                         VerticalAlignment="Center"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- CONFIRMAR SENHA -->
                        <TextBlock Text="Confirmar senha"
                                   Grid.Row="4"
                                   Margin="0,20,0,8"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#FF1E293B"/>

                        <Border Grid.Row="5"
                                Height="55"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1.5">

                            <PasswordBox x:Name="ConfirmarSenhaDigitada"
                                         VerticalAlignment="Center"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"
                                         KeyDown="ConfirmarSenhaDigitada_KeyDown"/>
                        </Border>

                        <!-- BOTÕES -->
                        <Grid Grid.Row="6"
                              Margin="0,35,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Content="Alterar Senha"
                                    Grid.Row="0"
                                    Height="50"
                                    Background="#FF7C3AED"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="15"
                                    Cursor="Hand"
                                    Click="btnAlterarSenha_Click">

                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      ShadowDepth="0"
                                                      Opacity="0.30"
                                                      RenderingBias="Quality"/>
                                </Button.Effect>
                            </Button>

                            <Button Content="← Voltar para Login"
                                    Grid.Row="1"
                                    Height="45"
                                    Margin="0,18,0,0"
                                    Background="#FFEF4444"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="15"
                                    Cursor="Hand"
                                    Click="btnVoltar_Click">

                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      ShadowDepth="0"
                                                      Opacity="0.25"
                                                      RenderingBias="Quality"/>
                                </Button.Effect>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>