<Page x:Class="ProjetoIntegrador.TelaLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="TelaLogin">

    <Grid Background="#FF0F172A">

        <!-- FUNDO -->
        <Rectangle HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">

            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>

        </Rectangle>

        <!-- DECORAÇÃO -->
        <Ellipse Width="240"
                 Height="240"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-90,-70,0,0"
                 Fill="#227C3AED"/>

        <Ellipse Width="180"
                 Height="180"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-40,-40"
                 Fill="#223B82F6"/>

        <!-- GRID PRINCIPAL -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO -->
            <Grid Grid.Column="0">

                <StackPanel Margin="45,60,0,0"
                            VerticalAlignment="Top">

                    <TextBlock Text="WRV Control"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Gerencie usuários, estoque&#10;e controle seu sistema com facilidade."
                               Margin="0,18,0,0"
                               FontSize="17"
                               Foreground="#FFD1D5DB"/>

                    <!-- CARD 1 -->
                    <Border Width="240"
                            Height="60"
                            Margin="0,55,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="14"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">

                        <StackPanel Margin="15,8,0,0">

                            <TextBlock Text="🔒 Login Seguro"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Proteção avançada dos dados"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#FFD1D5DB"/>

                        </StackPanel>

                    </Border>

                    <!-- CARD 2 -->
                    <Border Width="240"
                            Height="60"
                            Margin="0,15,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="14"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">

                        <StackPanel Margin="15,8,0,0">

                            <TextBlock Text="⚡ Sistema Rápido"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Interface moderna e fluida"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#FFD1D5DB"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- CARD LOGIN -->
            <Grid Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Width="360"
                        Height="380"
                        Background="#CCFFFFFF"
                        CornerRadius="22"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25"
                                          ShadowDepth="0"
                                          Opacity="0.30"/>
                    </Border.Effect>

                    <Canvas>

                        <!-- TITULO -->
                        <Label Content="Bem-vindo"
                               Canvas.Left="103"
                               Canvas.Top="25"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF0F172A"/>

                        <Label Content="Faça login para continuar"
                               Canvas.Left="97"
                               Canvas.Top="67"
                               FontSize="13"
                               Foreground="#FF64748B"/>

                        <!-- USUARIO -->
                        <Label Content="Usuário"
                               Canvas.Left="45"
                               Canvas.Top="118"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FF1E293B"/>

                        <Border Width="270"
                                Height="45"
                                Canvas.Left="45"
                                Canvas.Top="143"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1">

                            <TextBox x:Name="User1"
                                     Width="245"
                                     Height="32"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Padding="8"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- SENHA -->
                        <Label Content="Senha"
                               Canvas.Left="45"
                               Canvas.Top="205"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FF1E293B"/>

                        <Border Width="270"
                                Height="45"
                                Canvas.Left="45"
                                Canvas.Top="230"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1">

                            <PasswordBox x:Name="Senha1"
                                         Width="245"
                                         Height="32"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         Padding="8"
                                         KeyDown="Senha1_KeyDown"/>
                        </Border>

                        <!-- RECUPERAR -->
                        <Button x:Name="Recuperar"
                                Content="Esqueceu sua senha?"
                                Width="140"
                                Height="22"
                                Canvas.Left="170"
                                Canvas.Top="285"
                                Background="Transparent"
                                Foreground="#FF7C3AED"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Cursor="Hand"/>

                        <!-- BOTÕES -->
                        <Button Content="Cadastrar"
                                Width="120"
                                Height="42"
                                Canvas.Left="45"
                                Canvas.Top="320"
                                Background="#FF7C3AED"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="13"
                                Cursor="Hand"
                                Click="Button_Click">

                            <Button.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.25"/>
                            </Button.Effect>

                        </Button>

                        <Button Content="Acessar"
                                Width="120"
                                Height="42"
                                Canvas.Left="195"
                                Canvas.Top="320"
                                Background="#FF22C55E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="13"
                                Cursor="Hand"
                                Click="Button_Click_1">

                            <Button.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.25"/>
                            </Button.Effect>

                        </Button>

                    </Canvas>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Page>