<Page x:Class="ProjetoIntegrador.TelaLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Title="TelaLogin"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Width="1920"
          Height="1080"
          Background="#FF0F172A"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">

        <!-- FUNDO COM GRADIENTE -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- ELEMENTOS DECORATIVOS - AUMENTADOS PROPORCIONALMENTE -->
            <Ellipse Width="450"
                     Height="450"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-150,-120,0,0"
                     Fill="#227C3AED"
                     RenderOptions.BitmapScalingMode="HighQuality"/>

            <Ellipse Width="350"
                     Height="350"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-70,-70"
                     Fill="#223B82F6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- CÍRCULO DECORATIVO ADICIONAL NO CENTRO -->
            <Ellipse Width="280"
                     Height="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Margin="650,0,0,0"
                     Fill="#113B82F6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <!-- GRID PRINCIPAL -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="580"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO -->
            <Grid Grid.Column="0">
                <StackPanel Margin="120,120,0,0"
                            VerticalAlignment="Top">

                    <TextBlock Text="WRV Control"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="White"
                               TextOptions.TextFormattingMode="Display" Width="326"/>

                    <TextBlock Text="Gerencie usuários, estoque e controle seu sistema com facilidade."
                               Margin="0,30,0,0"
                               FontSize="24"
                               Foreground="#FFD1D5DB"
                               TextWrapping="Wrap"
                               MaxWidth="500"
                               TextOptions.TextFormattingMode="Display" Width="392"/>

                    <!-- CARDS INFORMATIVOS -->
                    <Border Width="380"
                            Height="90"
                            Margin="0,100,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="🔒 Login Seguro"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Proteção avançada dos dados"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>

                    <Border Width="380"
                            Height="90"
                            Margin="0,25,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="⚡ Sistema Rápido"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Interface moderna e fluida"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>

                    <Border Width="380"
                            Height="90"
                            Margin="0,25,0,0"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">

                        <StackPanel Margin="20,12,0,0">
                            <TextBlock Text="📊 Dashboard Intuitivo"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Visualize seus dados em tempo real"
                                       Margin="0,6,0,0"
                                       FontSize="15"
                                       Foreground="#FFD1D5DB"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CARD DE LOGIN - DIMENSIONADO PROPORCIONALMENTE -->
            <Grid Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Width="500"
        Height="600"
        Canvas.Left="1050"
        Canvas.Top="240"
        Background="#CCFFFFFF"
        CornerRadius="24"
        BorderBrush="#33FFFFFF"
        BorderThickness="1.5" Margin="-250,-10,250,10">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35"
                                        ShadowDepth="0"
                                        Opacity="0.35"
                                        RenderingBias="Quality"/>
                    </Border.Effect>

                    <Grid Margin="55,35,55,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->
                        <TextBlock Text="Bem Vindo"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="Black"/>

                        <TextBlock Text="Faça login para continuar"
                                   Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   FontSize="18"
                                   Foreground="#FF64748B"/>

                        <!-- USUÁRIO -->
                        <TextBlock Text="Usuário"
                                   Grid.Row="2"
                                   Margin="0,35,0,8"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#FF1E293B"/>

                        <Border Grid.Row="3"
                                Height="55"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1.5">
                            <TextBox x:Name="User1"
                                     VerticalAlignment="Center"
                                     Margin="12,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="16"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- SENHA -->
                        <TextBlock Text="Senha"
                                   Grid.Row="4"
                                   Margin="0,20,0,8"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#FF1E293B"/>

                        <Border Grid.Row="5"
                                Height="55"
                                Background="#FFF8FAFC"
                                CornerRadius="12"
                                BorderBrush="#FFE2E8F0"
                                BorderThickness="1.5">
                            <PasswordBox x:Name="Senha1"
                                         VerticalAlignment="Center"
                                         Margin="12,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="16"
                                         KeyDown="Senha1_KeyDown"/>
                        </Border>

                        <!-- BOTÕES E LINK -->
                        <Grid Grid.Row="6"
                              Margin="0,30,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- LINK RECUPERAR SENHA -->
                            <Button x:Name="Recuperar"
                                    Content="Esqueceu sua senha?"
                                    Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Margin="26,0,0,15"
                                    Background="Transparent"
                                    Foreground="#FF7C3AED"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="Recuperar_Click"/>

                            <!-- BOTÕES DE AÇÃO -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="Cadastrar"
                                        Width="150"
                                        Height="50"
                                        Background="#FF7C3AED"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        FontSize="15"
                                        Cursor="Hand"
                                        Click="Button_Click">
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="15"
                                                        ShadowDepth="0"
                                                        Opacity="0.30"
                                                        RenderingBias="Quality"/>
                                    </Button.Effect>
                                </Button>

                                <Button Content="Acessar"
                                        Width="150"
                                        Height="50"
                                        Margin="35,0,0,0"
                                        Background="#FF22C55E"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        FontSize="15"
                                        Cursor="Hand"
                                        Click="Button_Click_1">
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="15"
                                                        ShadowDepth="0"
                                                        Opacity="0.30"
                                                        RenderingBias="Quality"/>
                                    </Button.Effect>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>