<Page x:Class="ProjetoIntegrador.TelaLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TelaLogin">

    <Canvas Background="White">
        <!-- ================================================= -->
        <!-- LOGIN -->
        <!-- ================================================= -->

        <Canvas x:Name="Login1"
 Visibility="Visible"
 Width="800"
 Height="450"
 Background="#FFF5F5F5">

            <!-- FUNDO -->
            <Rectangle Width="800"
        Height="450"
        Fill="#FFF5F5F5"/>

            <!-- CARD LOGIN -->
            <Border Width="320"
     Height="310"
     Canvas.Left="240"
     Canvas.Top="70"
     Background="White"
     CornerRadius="12"
     BorderBrush="#22000000"
     BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top">

                <Canvas>

                    <!-- LOGO -->
                    <Label Content="WRV"
            Canvas.Left="67"
            Canvas.Top="25"
            FontWeight="Bold"
            FontStyle="Italic"
            FontSize="28"
            Foreground="#FF2563EB" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <Label Content="Control"
            Canvas.Left="147"
            Canvas.Top="25"
            FontWeight="Bold"
            FontSize="28"
            Foreground="#FF1E293B" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- SUBTITULO -->
                    <Label Content="Faça login para continuar"
            Canvas.Left="82"
            Canvas.Top="83"
            FontSize="13"
            Foreground="Gray"/>

                    <!-- USUARIO -->
                    <Label Content="Usuário"
            Canvas.Left="40"
            Canvas.Top="115"
            FontWeight="Bold"
            Foreground="#FF1E293B"/>

                    <TextBox x:Name="User1"
              Width="240"
              Height="32"
              Canvas.Left="40"
              Canvas.Top="140"
              Padding="8"
              BorderBrush="#FFCBD5E1"
              Background="#FFF8FAFC"/>
                    
                    <!-- SENHA -->
                    <Label Content="Senha"
            Canvas.Left="40"
            Canvas.Top="180"
            FontWeight="Bold"
            Foreground="#FF1E293B"/>

                    <PasswordBox x:Name="Senha1"
                  Width="240"
                  Height="32"
                  Canvas.Left="40"
                  Canvas.Top="205"
                  Padding="8"
                  BorderBrush="#FFCBD5E1"
                  Background="#FFF8FAFC"/>

                    <!-- BOTÕES -->
                    <Button Content="Recuperar"
             Width="100"
             Height="35"
             Canvas.Left="40"
             Canvas.Top="255"
             Background="#FF7C3AED"
             Foreground="White"
             BorderThickness="0"
             FontWeight="Bold"/>

                    <Button Content="Acessar"
             Width="100"
             Height="35"
             Canvas.Left="180"
             Canvas.Top="255"
             Background="#FF22C55E"
             Foreground="White"
             BorderThickness="0"
             FontWeight="Bold"/>

                </Canvas>

            </Border>

        </Canvas>
    </Canvas>

</Page>
