<Page x:Class="ProjetoIntegrador.TelaLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="TelaLogin"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">


        <Grid Width="800"
              Height="450"
              Background="#FF0F172A"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">

            <!-- FUNDO COM GRADIENTE -->
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0F172A" Offset="0"/>
                        <GradientStop Color="#FF1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- ELEMENTOS DECORATIVOS -->
                <Ellipse Width="240"
                         Height="240"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-90,-70,0,0"
                         Fill="#227C3AED"
                         RenderOptions.BitmapScalingMode="HighQuality"/>

                <Ellipse Width="180"
                         Height="180"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-40,-40"
                         Fill="#223B82F6"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <!-- GRID PRINCIPAL -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- PAINEL ESQUERDO -->
                <Grid Grid.Column="0">
                    <StackPanel Margin="45,60,0,0"
                                VerticalAlignment="Top">

                        <TextBlock Text="WRV Control"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextOptions.TextFormattingMode="Display"/>

                        <TextBlock Text="Gerencie usuários, estoque e controle seu sistema com facilidade."
                                   Margin="0,18,0,0"
                                   FontSize="17"
                                   Foreground="#FFD1D5DB"
                                   TextWrapping="Wrap"
                                   TextOptions.TextFormattingMode="Display"/>

                        <!-- CARDS INFORMATIVOS -->
                        <Border Width="240"
                                Height="60"
                                Margin="0,55,0,0"
                                Background="#11FFFFFF"
                                CornerRadius="14"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">

                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="🔒 Login Seguro"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Proteção avançada dos dados"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#FFD1D5DB"/>
                            </StackPanel>
                        </Border>

                        <Border Width="240"
                                Height="60"
                                Margin="0,15,0,0"
                                Background="#11FFFFFF"
                                CornerRadius="14"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">

                            <StackPanel Margin="15,8,0,0">
                                <TextBlock Text="⚡ Sistema Rápido"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Interface moderna e fluida"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#FFD1D5DB"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- CARD DE LOGIN -->
                <Grid Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Border Width="360"
                            Height="380"
                            Background="#CCFFFFFF"
                            CornerRadius="22"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25"
                                            ShadowDepth="0"
                                            Opacity="0.30"
                                            RenderingBias="Quality"/>
                        </Border.Effect>

                        <Grid Margin="45,26,45,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TÍTULO -->
                            <TextBlock Text="Bem Vindo"
                                       Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="Black"/>

                            <TextBlock Text="Faça login para continuar"
                                       Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       FontSize="16"
                                       Foreground="#FF64748B"/>

                            <!-- USUÁRIO -->
                            <TextBlock Text="Usuário"
                                       Grid.Row="2"
                                       Margin="0,25,0,5"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#FF1E293B"/>

                            <Border Grid.Row="3"
                                    Height="45"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1">
                                <TextBox x:Name="User1"
                                         VerticalAlignment="Center"
                                         Margin="8,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"/>
                            </Border>

                            <!-- SENHA -->
                            <TextBlock Text="Senha"
                                       Grid.Row="4"
                                       Margin="0,15,0,5"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#FF1E293B"/>

                            <Border Grid.Row="5"
                                    Height="45"
                                    Background="#FFF8FAFC"
                                    CornerRadius="12"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1">
                                <PasswordBox x:Name="Senha1"
                                             VerticalAlignment="Center"
                                             Margin="8,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             KeyDown="Senha1_KeyDown"/>
                            </Border>

                            <!-- BOTÕES E LINK -->
                            <Grid Grid.Row="6"
                                  Margin="0,25,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- LINK RECUPERAR SENHA -->
                                <Button x:Name="Recuperar"
                                        Content="Esqueceu sua senha?"
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,12"
                                        Background="Transparent"
                                        Foreground="#FF7C3AED"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        Cursor="Hand"
                                        Click="Recuperar_Click"/>

                                <!-- BOTÕES DE AÇÃO -->
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="Cadastrar"
                                            Width="120"
                                            Height="42"
                                            Background="#FF7C3AED"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="Button_Click">
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="12"
                                                            ShadowDepth="0"
                                                            Opacity="0.25"
                                                            RenderingBias="Quality"/>
                                        </Button.Effect>
                                    </Button>

                                    <Button Content="Acessar"
                                            Width="120"
                                            Height="42"
                                            Margin="30,0,0,0"
                                            Background="#FF22C55E"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="Button_Click_1">
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="12"
                                                            ShadowDepth="0"
                                                            Opacity="0.25"
                                                            RenderingBias="Quality"/>
                                        </Button.Effect>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
</Page>