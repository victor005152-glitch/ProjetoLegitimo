<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Home">

    <Canvas Background="#FF0F172A" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Center">

        <!-- FUNDO -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0F172A" Offset="0"/>
                    <GradientStop Color="#FF1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ================================================= -->
        <!-- MENU LATERAL -->
        <!-- ================================================= -->
        <Border Width="280"
                    Visibility="Visible"
                    Height="1080"
                    Background="#FF131111"
                    CornerRadius="0,24,24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>
            </Border.Effect>

            <Canvas>
                <!-- LOGO -->
                <Label Content="WRV CONTROL"
                           Canvas.Left="15"
                           Canvas.Top="45"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Height="55" 
                           VerticalAlignment="Top" 
                           Width="250"/>

                <Label Content="Sistema Inteligente"
                           Canvas.Left="25"
                           Canvas.Top="90"
                           FontSize="15"
                           Foreground="#FF9CA3AF"/>

                <!-- LINHA -->
                <Rectangle Width="220"
                             Height="1.5"
                             Fill="#33FFFFFF"
                             Canvas.Left="30"
                             Canvas.Top="130"/>

                <!-- BOTÕES DO MENU -->
                <Button x:Name="BotaoEstoque"
                            Content="📦 Estoque"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="175"
                            Click="BotaoEstoque_Click"
                            Background="Black"
                            Foreground="White"
                           
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>

                <!-- NOVO BOTÃO VENDAS -->
                <Button x:Name="BotaoVendas"
                            Content="🛒 Vendas"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="245"
                         
                            Background="Black"
                            Foreground="White"
                           
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="" Click="BotaoVendas_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                    </Button.Effect>
                </Button>



                <Button x:Name="BotaoHistorico"
                            Content="🧾 Histórico"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="315"
                            Click="Button_Click_1"
                            Background="Black"
                            Foreground="White"
                            BorderBrush="#FF707070"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                <Button x:Name="BotaoFinanceiro" 
                            Content="   💰 Financeiro"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="385"
                            Click="Button_Click_2"
                            Background="Black"
                            Foreground="White"
                            BorderBrush="#FF707070"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>
                <Button x:Name="BotaoEmpresa"
                            Content="⚙️ Empresa"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="455"
                              Click="Button_Click_2"
  Background="Black"
  Foreground="White"
  BorderBrush="#FF707070"
                            
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>
                <Button x:Name="BotaoClientes"
        Content="👥 Clientes"
        Width="220"
        Height="55"
        Canvas.Left="30"
        Canvas.Top="523"
        Click="BotaoClientes_Click"
        Background="Black"
        Foreground="White"
        
        FontSize="16"
        FontWeight="Bold"
        Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- CARD INFO -->
                <Border Width="220"
                            Height="100"
                            Canvas.Left="30"
                           Canvas.Top="594"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Canvas>
                        <Label Content="⚡ WRV Premium"
                                   Canvas.Left="18"
                                   Canvas.Top="15"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="White"/>
                        <Label Content="Sistema moderno&#x0a;e otimizado"
                                   Canvas.Left="18"
                                   Canvas.Top="45"
                                   FontSize="13"
                                   Foreground="#FFD1D5DB"/>
                    </Canvas>
                </Border>

                <!-- BOTÃO SAIR -->
                <Button Content="🚪 Sair"
                            Width="220"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="975"
                            Background="Red"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="Button_Click_3"/>
            </Canvas>
        </Border>

        <!-- TOPO -->
        <Border Canvas.Left="280"
                    Visibility="Visible"
                    Width="1640"
                    Height="70"
                    Background="#CC0F0F10"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1.5">
            <Canvas>
                <Label Content="Sistema de Controle"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Canvas.Left="30"
                           Canvas.Top="15"/>
                <Label Content="Gerenciamento inteligente"
                           FontSize="14"
                           Foreground="#FFD1D5DB"
                           Canvas.Left="32"
                           Canvas.Top="45"/>
            </Canvas>
        </Border>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL - ESTOQUE -->
        <!-- ================================================= -->
        <Canvas x:Name="Estoque1"
                    Visibility="Visible"
                    Width="1640"
                    Height="1010"
                    Canvas.Left="280"
                    Canvas.Top="70"
                    Background="Black">

            <!-- CARDS SUPERIORES -->
            <Border Width="260"
                        Height="95"
                        Canvas.Left="25"
                        Canvas.Top="25"
                        Background="#FF131111"
                        CornerRadius="20">
                <Canvas>
                    <Label Content="📦 Produtos"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <Label x:Name="QTD" 
                               Content="125"
                               Canvas.Left="22"
                               Canvas.Top="45"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF7C3AED"/>
                </Canvas>
            </Border>

            <!-- CONTROLES -->
            <Button x:Name="Cad"
                        Content="➕ Cadastrar"
                        Width="160"
                        Height="45"
                        Canvas.Left="25"
                        Canvas.Top="145"
                        Click="Cad_Click1"
                        Background="#FF00B342"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"/>

            <Button x:Name="ATL"
                        Content="↻ Atualizar"
                        Width="160"
                        Height="45"
                        Canvas.Left="420"
                        Canvas.Top="145"
                        Click="ATL_Click1"
                        Background="#FF0004FF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"/>

            <Button x:Name="Exc"
                        Content="🗑 Excluir"
                        Width="140"
                        Height="45"
                        Canvas.Left="232"
                        Canvas.Top="145"
                        Click="Exc_Click"
                        Background="#FFFB0000"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Width="260"
                        Height="45"
                        Canvas.Left="1345"
                        Canvas.Top="145"
                        Background="#FF131111"
                        CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBox x:Name="Pesquisa1" 
                             Width="240"
                             Text="Pesquisar..."
                             Padding="12"
                             BorderThickness="0"
                             GotFocus="Pesquisa_GotFocus"
                             LostFocus="Pesquisa_LostFocus"
                             Background="Transparent"
                             VerticalContentAlignment="Center" 
                             Margin="10,2,10,2"
                             TextChanged="Pesquisa1_TextChanged" Foreground="White"/>
            </Border>

            <!-- TABELA -->
            <Border Width="1580"
                        Height="380"
                        Canvas.Left="25"
                        Canvas.Top="210"
                        Background="#CCFFFFFF"
                        CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                        ShadowDepth="0"
                                        Opacity="0.15"/>
                </Border.Effect>

                <DataGrid x:Name="DGestoque"
          Visibility="Visible"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Background="#FF131111"
          Foreground="White"
          RowBackground="#FF131111"
          AlternatingRowBackground="#FF181818"
          BorderThickness="0"
          FontSize="14"
          RowHeight="35"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#FF404040"
          VerticalGridLinesBrush="#FF404040"
          AlternationCount="2"
          SelectionMode="Single"
          SelectionUnit="FullRow">

                    <!-- CABEÇALHO -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF131111"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="BorderBrush" Value="#FF707070"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- LINHAS -->
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="#FF131111"/>
                            <Setter Property="Foreground" Value="White"/>

                            <Style.Triggers>

                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FF181818"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF252525"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF7C3AED"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- CÉLULAS -->
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#FF404040"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Style.Triggers>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF7C3AED"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn x:Name="CollumCodigo"
                            Header="Código"
                            Width="150"
                            Binding="{Binding CodigoBarras}"/>

                        <DataGridTextColumn x:Name="CollumNome"
                            Header="Nome"
                            Width="200"
                            Binding="{Binding Nome}"/>

                        <DataGridTextColumn x:Name="CollumCategoria"
                            Header="Categoria"
                            Width="180"
                            Binding="{Binding Categoria}"/>

                        <DataGridTextColumn x:Name="CollumMarca"
                            Header="Marca"
                            Width="180"
                            Binding="{Binding Marca}"/>

                        <DataGridTextColumn x:Name="CollumQuantidade"
                            Header="Quantidade"
                            Width="150"
                            Binding="{Binding QuantidadeEstoque}"/>

                        <DataGridTextColumn x:Name="CollumCusto"
                            Header="Custo"
                            Width="150"
                            Binding="{Binding ValorCusto,
                                              StringFormat=R$ {0:N2}}"/>

                        <DataGridTextColumn x:Name="CollumVenda"
                            Header="Venda"
                            Width="150"
                            Binding="{Binding ValorVenda,
                                              StringFormat=R$ {0:N2}}"/>

                    </DataGrid.Columns>

                </DataGrid>
            </Border>

            <!--=============================-->
            <!-- TELA DE CADASTRO DE PRODUTO -->
            <!--=============================-->
            <Grid x:Name="Cadastro" Visibility="Collapsed">

                <Border Width="450"
            Height="550"
            Canvas.Left="404"
            Canvas.Top="186"
            CornerRadius="22"
            Background="#FF2D334C" Margin="480,275,-480,-275">

                    <Canvas>

                        <Button x:Name="Fechar"
                    Content="❌"
                    Width="40"
                    Height="40"
                    Canvas.Left="400"
                    Canvas.Top="10"
                    BorderBrush="{x:Null}"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="18"
                    Click="Fechar_Click"/>

                        <!-- Código -->
                        <Label Content="Código"
                   Canvas.Left="40"
                   Canvas.Top="35"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="25">

                            <TextBox x:Name="Codigo1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Nome -->
                        <Label Content="Nome"
                   Canvas.Left="40"
                   Canvas.Top="100"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="90">

                            <TextBox x:Name="Nome1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Categoria -->
                        <Label Content="Categoria"
                   Canvas.Left="40"
                   Canvas.Top="165"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="155">

                            <TextBox x:Name="Categoria1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Marca -->
                        <Label Content="Marca"
                   Canvas.Left="40"
                   Canvas.Top="230"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="220">

                            <TextBox x:Name="Marca1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Custo -->
                        <Label Content="Custo"
                   Canvas.Left="40"
                   Canvas.Top="295"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="285">

                            <TextBox x:Name="Custo1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Venda -->
                        <Label Content="Venda"
                   Canvas.Left="40"
                   Canvas.Top="360"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="350">

                            <TextBox x:Name="Venda1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <!-- Quantidade -->
                        <Label Content="QTD"
                   Canvas.Left="40"
                   Canvas.Top="425"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="160"
                    Canvas.Top="415">

                            <TextBox x:Name="Quantidade1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"
                         KeyDown="Quantidade_KeyDown"/>
                        </Border>

                        <Button x:Name="Save"
                    Content="➕ Salvar"
                    Width="170"
                    Height="48"
                    Canvas.Left="140"
                    Canvas.Top="485"
                    Click="Cad_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="16"
                    Cursor="Hand"/>

                    </Canvas>

                </Border>

            </Grid>

            <!--=============================-->
            <!-- TELA DE ATUALIZAR ESTOQUE -->
            <!--=============================-->
            <Grid x:Name="AtualizarEstoque" Visibility="Collapsed">

                <Border Width="450"
            Height="550"
            CornerRadius="22"
            Background="#FF2D334C"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="480,275,-480,-275">

                    <Canvas>

                        <Button x:Name="Fechar1"
                    Content="❌"
                    Width="40"
                    Height="40"
                    Canvas.Left="395"
                    Canvas.Top="10"
                    BorderBrush="{x:Null}"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="18"
                    Click="Fechar_Click"/>

                        <Label Content="Código"
                   Canvas.Left="10"
                   Canvas.Top="177"
                   FontWeight="Bold"
                   Foreground="White"
                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="105"
                    Canvas.Top="170" HorizontalAlignment="Left" VerticalAlignment="Center">

                            <TextBox x:Name="Codigo"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"/>
                        </Border>

                        <Label Content="QTD"
                   Canvas.Left="10"
                   Canvas.Top="246"
                   FontWeight="Bold"
                   Foreground="White"
                   FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <Border Width="240"
                    Height="45"
                    Background="#CCFFFFFF"
                    CornerRadius="12"
                    Canvas.Left="105"
                    Canvas.Top="239">

                            <TextBox x:Name="QTD1"
                         Width="220"
                         Padding="10"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="10,2,10,2"
                         FontSize="15"
                         KeyDown="QTD1_KeyDown"/>
                        </Border>

                        <Button x:Name="Atualizar"
                    Content="➕ Atualizar"
                    Width="170"
                    Height="48"
                    Canvas.Left="140"
                    Canvas.Top="430"
                    Click="ATL_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    FontSize="16"
                    Cursor="Hand"/>

                    </Canvas>

                </Border>

            </Grid>
        </Canvas>
    </Canvas>
</Page>