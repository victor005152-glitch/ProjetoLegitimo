<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">
    <Viewbox Stretch="Uniform">
        <Canvas Background="#FF0F172A" Width="800" Height="450" HorizontalAlignment="Left" VerticalAlignment="Center" >

            <!-- FUNDO -->
            <Rectangle Width="800"
             Height="450">

                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0F172A" Offset="0"/>
                        <GradientStop Color="#FF1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>

            </Rectangle>

            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <Border Width="185"
          Visibility="Visible"
          Height="450"
          Background="#CC111827"
          CornerRadius="0,18,18,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                            ShadowDepth="0"
                            Opacity="0.20"/>
                </Border.Effect>

                <Canvas>

                    <!-- LOGO -->
                    <Label Content="WRV CONTROL"
                 Canvas.Left="1"
                 Canvas.Top="25"
                 FontWeight="Bold"
                 FontSize="24"
                 Foreground="White" HorizontalAlignment="Center" Height="45" VerticalAlignment="Top" Width="184"/>

                    <Label Content="Sistema Inteligente"
                 Canvas.Left="18"
                 Canvas.Top="58"
                 FontSize="11"
                 Foreground="#FF9CA3AF"/>

                    <!-- LINHA -->
                    <Rectangle Width="145"
                     Height="1"
                     Fill="#22FFFFFF"
                     Canvas.Left="20"
                     Canvas.Top="90"/>

                    <!-- BOTÕES -->

                    <Button x:Name="BotaoEstoque"
                  Content="📦 Estoque"
                  Width="145"
                  Height="42"
                  Canvas.Left="20"
                  Canvas.Top="120"
                  Click="BotaoEstoque_Click"
                  Background="#FF1F2937"
                  Foreground="White"
                  BorderThickness="0"
                  FontWeight="Bold"
                  FontSize="13"
                  Cursor="Hand">

                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                    ShadowDepth="0"
                                    Opacity="0.20"/>
                        </Button.Effect>

                    </Button>

                    <Button x:Name="BotaoHistorico"
                  Content="🧾 Histórico"
                  Width="145"
                  Height="42"
                  Canvas.Left="20"
                  Canvas.Top="175"
                  Click="Button_Click_1"
                  Background="#FF1F2937"
                  Foreground="White"
                  BorderBrush="#223B82F6"
                  FontWeight="Bold"
                  FontSize="13"
                  Cursor="Hand"/>

                    <Button x:Name="BotaoFinanceiro" Content="💰 Financeiro"
                  Width="145"
                  Height="42"
                  Canvas.Left="20"
                  Canvas.Top="230"
                  Click="Button_Click_2"
                  Background="#FF1F2937"
                  Foreground="White"
                  BorderBrush="#223B82F6"
                  FontWeight="Bold"
                  FontSize="13"
                  Cursor="Hand"/>

                    <!-- CARD INFO -->
                    <Border Width="145"
                  Height="72"
                  Canvas.Left="20"
                  Canvas.Top="305"
                  Background="#11FFFFFF"
                  CornerRadius="14"
                  BorderBrush="#22FFFFFF"
                  BorderThickness="1">

                        <Canvas>

                            <Label Content="⚡ WRV Premium"
                         Canvas.Left="12"
                         Canvas.Top="10"
                         FontWeight="Bold"
                         FontSize="13"
                         Foreground="White"/>

                            <Label Content="Sistema moderno&#x0a;e otimizado"
                         Canvas.Left="12"
                         Canvas.Top="33"
                         FontSize="11"
                         Foreground="#FFD1D5DB"/>

                        </Canvas>

                    </Border>

                    <!-- SAIR -->
                    <Button Content="🚪 Sair"
                  Width="145"
                  Height="40"
                  Canvas.Left="20"
                  Canvas.Top="392"
                  Background="#FFDC2626"
                  Foreground="White"
                  BorderThickness="0"
                  FontWeight="Bold"
                  FontSize="13"
                  Cursor="Hand" Click="Button_Click_3"/>

                </Canvas>

            </Border>

            <!-- TOPO -->
            <Border Canvas.Left="185"
          Visibility="Visible"
          Width="615"
          Height="56"
          Background="#11FFFFFF"
          BorderBrush="#22FFFFFF"
          BorderThickness="0,0,0,1">

                <Canvas>

                    <Label Content="Sistema de Controle"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="White"
                 Canvas.Left="20"
                 Canvas.Top="13"/>

                    <Label Content="Gerenciamento inteligente"
                 FontSize="11"
                 Foreground="#FFD1D5DB"
                 Canvas.Left="22"
                 Canvas.Top="35"/>

                </Canvas>

            </Border>



            <!-- ================================================= -->
            <!-- ESTOQUE -->
            <!-- ================================================= -->

            <Canvas x:Name="Estoque1"
          Visibility="Visible"
          Width="615"
          Height="394"
          Canvas.Left="185"
          Canvas.Top="56"
          Background="Transparent">

                <!-- CARDS -->

                <Border Width="175"
              Height="72"
              Canvas.Left="15"
              Canvas.Top="15"
              Background="#CCFFFFFF"
              CornerRadius="18">

                    <Canvas>

                        <Label Content="📦 Produtos"
                     Canvas.Left="15"
                     Canvas.Top="10"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="#FF1E293B"/>

                        <Label x:Name="QTD" Content="125"
                     Canvas.Left="17"
                     Canvas.Top="33"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#FF7C3AED"/>

                    </Canvas>

                </Border>

                <Border Width="175"
              Height="72"
              Canvas.Left="210"
              Canvas.Top="15"
              Background="#CCFFFFFF"
              CornerRadius="18">

                    <Canvas>

                        <Label Content="💰 Vendas"
                     Canvas.Left="15"
                     Canvas.Top="10"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="#FF1E293B"/>

                        <Label x:Name="VND" Content="R$ 4.200"
                     Canvas.Left="17"
                     Canvas.Top="33"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="#FF22C55E"/>

                    </Canvas>

                </Border>

                <Border Width="175"
              Height="72"
              Canvas.Left="405"
              Canvas.Top="15"
              Background="#CCFFFFFF"
              CornerRadius="18">

                    <Canvas>

                        <Label Content="🧾 Histórico"
                     Canvas.Left="15"
                     Canvas.Top="10"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="#FF1E293B"/>

                        <Label Content="58"
                     Canvas.Left="17"
                     Canvas.Top="33"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#FF3B82F6"/>

                    </Canvas>

                </Border>

                <!-- CONTROLES -->

                <Button x:Name="Cad"
              Content="➕ Cadastrar"
              Width="125"
              Height="36"
              Canvas.Left="15"
              Canvas.Top="105"
              Click="Cad_Click1"
              Background="#FF22C55E"
              Foreground="White"
              BorderThickness="0"
              FontWeight="Bold"
              Cursor="Hand"/>

                <Button x:Name="ATL"
              Content="↻ Atualizarr"
              Width="125"
              Height="36"
              Canvas.Left="270"
              Canvas.Top="105"
              Click="ATL_Click1"
              Background="#FF22C55E"
              Foreground="White"
              BorderThickness="0"
              FontWeight="Bold"
              Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <Button x:Name="Exc"
              Content="🗑 Excluir"
              Width="110"
              Height="36"
              Canvas.Left="150"
              Canvas.Top="105"
              Click="Exc_Click"
              Background="#FFEF4444"
              Foreground="White"
              BorderThickness="0"
              FontWeight="Bold"
              Cursor="Hand"/>

                <Border Width="180"
              Height="36"
              Canvas.Left="405"
              Canvas.Top="105"
              Background="#CCFFFFFF"
              CornerRadius="10">


                    <TextBox x:Name="Pesquisa1" Width="160"
                   Text="Pesquisar..."
                   Padding="8"
                   BorderThickness="0"
                   GotFocus="Pesquisa_GotFocus"
                   LostFocus="Pesquisa_LostFocus"
                   Background="Transparent"
                   VerticalContentAlignment="Center" Margin="10,2,10,2"
                   TextChanged="Pesquisa1_TextChanged"/>

                </Border>

                <!-- TABELA -->

                <Border Width="570"
              Height="230"
              Canvas.Left="15"
              Canvas.Top="150"
              Background="#CCFFFFFF"
              CornerRadius="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                ShadowDepth="0"
                                Opacity="0.10"/>
                    </Border.Effect>

                    <DataGrid x:Name="DGestoque" Visibility="Visible"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    BorderThickness="0"
                    Background="Transparent">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="CollumCodigo" Header="Código"
                                      Binding="{Binding CodigoBarras}"/>

                            <DataGridTextColumn x:Name="CollumNome" Header="Nome"
                                      Binding="{Binding Nome}"/>

                            <DataGridTextColumn x:Name="CollumCategoria" Header="Categoria"
                                      Binding="{Binding Categoria}"/>

                            <DataGridTextColumn x:Name="CollumMarca" Header="Marca"
                                      Binding="{Binding Marca}"/>

                            <DataGridTextColumn x:Name="CollumQuantidade" Header="Quantidade"
                                      Binding="{Binding QuantidadeEstoque}"/>

                            <DataGridTextColumn x:Name="CollumCusto" Header="Custo"
                                      Binding="{Binding ValorCusto, StringFormat=R$ {0:N2}}"/>

                            <DataGridTextColumn x:Name="CollumVenda" Header="Venda"
                                      Binding="{Binding ValorVenda, StringFormat=R$ {0:N2}}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!--=============================-->
                    <!-- TELA DE CADASTRO DE PRODUTO -->
                    <!--=============================-->

                </Border>

                <Canvas x:Name="Cadastro" Visibility="Visible" >
                    <Border Width="334"
                    Height="410"
                    Canvas.Left="52"
                    Canvas.Top="-36"
                    CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF2D334C">


                    </Border>

                    <Button x:Name="Fechar" Content="❌" Canvas.Left="362" Canvas.Top="-36" BorderBrush="{x:Null}" Background="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Click="Fechar_Click"/>


                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="-29" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBox x:Name="Codigo1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>

                    <Border Width="180"
                    Height="36"
                    Background="#CCFFFFFF"
                    CornerRadius="10" Canvas.Left="129" Canvas.Top="21" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Nome1" Width="160"
                    Padding="8"
                    BorderThickness="0"
                    GotFocus="Pesquisa_GotFocus"
                    LostFocus="Pesquisa_LostFocus"
                    Background="Transparent"
                    VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>

                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="72" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Categoria1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>


                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="122" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Marca1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>
                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="169" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Custo1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>

                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="220" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Venda1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>

                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="269" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Quantidade1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"
                     KeyDown="Quantidade_KeyDown"/>
                    </Border>

                    <Label Content="Nome"
                   Canvas.Left="69"
                   Canvas.Top="21"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Width="64"/>

                    <Label Content="Código"
                    Canvas.Left="69"
                    Canvas.Top="-25"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Width="64"/>

                    <Label Content="Categoria"
                    Canvas.Left="65"
                    Canvas.Top="78"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Width="64" FontSize="11"/>

                    <Label Content="Marca"
                    Canvas.Left="69"
                    Canvas.Top="122"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" FontSize="14"/>

                    <Label Content="Custo"
                    Canvas.Left="69"
                    Canvas.Top="169"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" FontSize="14"/>

                    <Label Content="Venda"
                    Canvas.Left="69"
                    Canvas.Top="220"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Width="64" FontSize="14"/>

                    <Label Content="QTD"
                    Canvas.Left="69"
                    Canvas.Top="269"
                    FontWeight="Bold"
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Width="64" FontSize="14"/>
                    <Button x:Name="Save"
                    Content="➕ Salvar"
                    Width="126"
                    Height="36"
                    Canvas.Left="156"
                    Canvas.Top="322"
                    Click="Cad_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"/>

                </Canvas>
                <Canvas x:Name="AtualizarEstoque" Visibility="Collapsed">
                    <Border Width="334"
                     Height="410"
                     Canvas.Left="52"
                     Canvas.Top="-36"
                     CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF2D334C">
                    </Border>

                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="124" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="Codigo" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"/>
                    </Border>
                    <Border Width="180"
                     Height="36"
                     Background="#CCFFFFFF"
                     CornerRadius="10" Canvas.Left="129" Canvas.Top="178" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBox x:Name="QTD1" Width="160"
                     Padding="8"
                     BorderThickness="0"
                     GotFocus="Pesquisa_GotFocus"
                     LostFocus="Pesquisa_LostFocus"
                     Background="Transparent"
                     VerticalContentAlignment="Center" Margin="10,2,10,2" Opacity="1"
                       KeyDown="QTD1_KeyDown"/>


                    </Border>

                    <Label Content="QTD"
                     Canvas.Left="60"
                     Canvas.Top="182"
                     FontWeight="Bold"
                     Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Width="51" FontSize="14"/>

                    <Label Content="Código"
                     Canvas.Left="60"
                     Canvas.Top="128"
                     FontWeight="Bold"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" FontSize="14"/>

                    <Button x:Name="Atualizar"
                     Content="➕ Atualizar"
                     Width="126"
                     Height="36"
                     Canvas.Left="156"
                     Canvas.Top="322"
                     Click="ATL_Click"
                     Background="#FF22C55E"
                     Foreground="White"
                     BorderThickness="0"
                     FontWeight="Bold"
                     Cursor="Hand"/>

                    <Button x:Name="Fechar1" Content="❌" Canvas.Left="362" Canvas.Top="-36" BorderBrush="{x:Null}" Background="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Click="Fechar_Click"/>

                </Canvas>

            </Canvas>

        </Canvas>
    </Viewbox>

</Page>
