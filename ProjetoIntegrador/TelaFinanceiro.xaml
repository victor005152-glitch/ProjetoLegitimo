<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:Wpf="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"  
      x:Class="ProjetoIntegrador.TelaFinanceiro"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="TelaFinanceiro">

        <Canvas Background="#FF0F172A" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Center">

            <!-- FUNDO -->
            <Rectangle Width="1920" Height="1080">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0F172A" Offset="0"/>
                        <GradientStop Color="#FF1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ================================================= -->
            <!-- MENU LATERAL -->
            <!-- ================================================= -->
            <Border Width="280"
                    Visibility="Visible"
                    Height="1080"
                    Background="#CC111827"
                    CornerRadius="0,24,24,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                    ShadowDepth="0"
                                    Opacity="0.25"/>
                </Border.Effect>

                <Canvas>
                    <!-- LOGO -->
                    <Label Content="WRV CONTROL"
                           Canvas.Left="15"
                           Canvas.Top="45"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Height="55" 
                           VerticalAlignment="Top" 
                           Width="250"/>

                    <Label Content="Sistema Inteligente"
                           Canvas.Left="25"
                           Canvas.Top="90"
                           FontSize="15"
                           Foreground="#FF9CA3AF"/>

                    <!-- LINHA -->
                    <Rectangle Width="220"
                             Height="1.5"
                             Fill="#33FFFFFF"
                             Canvas.Left="30"
                             Canvas.Top="130"/>

                    <!-- BOTÕES DO MENU -->
                    <Button x:Name="BotaoEstoque"
                            Content="📦 Estoque"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="175"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="BotaoEstoque_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.25"/>
                        </Button.Effect>
                    </Button>

                    <Button x:Name="BotaoHistorico"
                            Content="🧾 Histórico"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="250"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderBrush="#223B82F6"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand" 
                            Click="BotaoHistorico_Click"/>

                    <Button x:Name="BotaoFinanceiro" 
                            Content="💰 Financeiro"
                            Width="220"
                            Height="55"
                            Canvas.Left="30"
                            Canvas.Top="325"
                            Background="#FF1F2937"
                            Foreground="White"
                            BorderBrush="#223B82F6"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>

                    <!-- CARD INFO -->
                    <Border Width="220"
                            Height="100"
                            Canvas.Left="30"
                            Canvas.Top="440"
                            Background="#11FFFFFF"
                            CornerRadius="16"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1.5">
                        <Canvas>
                            <Label Content="⚡ WRV Premium"
                                   Canvas.Left="18"
                                   Canvas.Top="15"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="White"/>
                            <Label Content="Sistema moderno&#xA;e otimizado"
                                   Canvas.Left="18"
                                   Canvas.Top="45"
                                   FontSize="13"
                                   Foreground="#FFD1D5DB"/>
                        </Canvas>
                    </Border>

                    <!-- BOTÃO SAIR -->
                    <Button Content="🚪 Sair"
                            Width="220"
                            Height="50"
                            Canvas.Left="30"
                            Canvas.Top="975"
                            Background="#FFDC2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="16"
                            Cursor="Hand"/>
                </Canvas>
            </Border>

            <!-- TOPO -->
            <Border Canvas.Left="280"
                    Visibility="Visible"
                    Width="1640"
                    Height="70"
                    Background="#11FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="0,0,0,1.5">
                <Canvas>
                    <Label Content="Sistema de Controle"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Canvas.Left="30"
                           Canvas.Top="15"/>
                    <Label Content="Gerenciamento inteligente"
                           FontSize="14"
                           Foreground="#FFD1D5DB"
                           Canvas.Left="32"
                           Canvas.Top="45"/>
                </Canvas>
            </Border>

            <!-- ================================================= -->
            <!-- ÁREA PRINCIPAL - FINANCEIRO -->
            <!-- ================================================= -->
            <Canvas x:Name="Financeiro"
                    Visibility="Visible"
                    Width="1640"
                    Height="1010"
                    Canvas.Left="280"
                    Canvas.Top="70"
                    Background="Transparent">

                <!-- CARDS DE RESUMO FINANCEIRO -->
                <Border Width="380"
                        Height="100"
                        Canvas.Left="25"
                        Canvas.Top="15"
                        Background="#CCFFFFFF"
                        CornerRadius="18">
                    <Canvas>
                        <Label Content="💰 Receita Total"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                        <Label x:Name="ReceitaTotal" 
                               Content="R$ 25.450,00"
                               Canvas.Left="22"
                               Canvas.Top="48"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF22C55E"/>
                    </Canvas>
                </Border>

                <Border Width="380"
                        Height="100"
                        Canvas.Left="430"
                        Canvas.Top="15"
                        Background="#CCFFFFFF"
                        CornerRadius="18">
                    <Canvas>
                        <Label Content="📊 Vendas do Mês"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                        <Label x:Name="VendasMes" 
                               Content="342"
                               Canvas.Left="22"
                               Canvas.Top="48"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF7C3AED"/>
                    </Canvas>
                </Border>

                <Border Width="380"
                        Height="100"
                        Canvas.Left="835"
                        Canvas.Top="15"
                        Background="#CCFFFFFF"
                        CornerRadius="18">
                    <Canvas>
                        <Label Content="📈 Ticket Médio"
                               Canvas.Left="20"
                               Canvas.Top="12"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FF1E293B"/>
                        <Label x:Name="TicketMedio" 
                               Content="R$ 74,42"
                               Canvas.Left="22"
                               Canvas.Top="48"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF3B82F6"/>
                    </Canvas>
                </Border>

                <!-- PAINEL PRINCIPAL COM GRÁFICOS -->
                <!-- O Grid é o ÚNICO filho desta Border -->
                <Border Width="1590"
                        Height="860"
                        Canvas.Left="25"
                        Canvas.Top="130"
                        Background="#CCFFFFFF"
                        CornerRadius="22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30"
                                        ShadowDepth="0"
                                        Opacity="0.15"/>
                    </Border.Effect>

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GRÁFICO DE LINHA PRINCIPAL -->
                        <lvc:CartesianChart 
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            Title="{Binding Title}"
                            LegendPosition="Hidden" 
                            Margin="10"
                            x:Name="Ind"/>

                        <!-- GRÁFICO DE PIZZA 1 -->
                        <lvc:PieChart
                            Grid.Row="1"
                            Grid.Column="0"
                            Series="{Binding Series}"
                            Title="{Binding Title1}" 
                            Margin="10" 
                            x:Name="PZ1"/>

                        <!-- GRÁFICO DE PIZZA 2 -->
                        <lvc:PieChart
                            Grid.Row="1"
                            Grid.Column="1"
                            Series="{Binding Series}"
                            Title="{Binding Title2}" 
                            Margin="10"  
                            x:Name="PZ2"/>
                    </Grid>
                </Border>
            </Canvas>
        </Canvas>
</Page>