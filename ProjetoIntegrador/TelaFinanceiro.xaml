<Page x:Class="ProjetoIntegrador.TelaFinanceiro"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TelaFinanceiro">
    <Viewbox Stretch="Uniform">
        <Canvas Background="#FF0F172A" Width="800" Height="450" HorizontalAlignment="Left" VerticalAlignment="Center" >

            <!-- FUNDO -->
            <Rectangle Width="800"
          Height="450">

                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0F172A" Offset="0"/>
                        <GradientStop Color="#FF1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>

            </Rectangle>

            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <Border Width="185"
       Visibility="Visible"
       Height="450"
       Background="#CC111827"
       CornerRadius="0,18,18,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                         ShadowDepth="0"
                         Opacity="0.20"/>
                </Border.Effect>

                <Canvas>

                    <!-- LOGO -->
                    <Label Content="WRV CONTROL"
              Canvas.Left="1"
              Canvas.Top="25"
              FontWeight="Bold"
              FontSize="24"
              Foreground="White" HorizontalAlignment="Center" Height="45" VerticalAlignment="Top" Width="184"/>

                    <Label Content="Sistema Inteligente"
              Canvas.Left="18"
              Canvas.Top="58"
              FontSize="11"
              Foreground="#FF9CA3AF"/>

                    <!-- LINHA -->
                    <Rectangle Width="145"
                  Height="1"
                  Fill="#22FFFFFF"
                  Canvas.Left="20"
                  Canvas.Top="90"/>

                    <!-- BOTÕES -->

                    <Button x:Name="BotaoEstoque"
               Content="📦 Estoque"
               Width="145"
               Height="42"
               Canvas.Left="20"
               Canvas.Top="120"

               Background="#FF7C3AED"
               Foreground="White"
               BorderThickness="0"
               FontWeight="Bold"
               FontSize="13"
               Cursor="Hand" Click="BotaoEstoque_Click">

                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                 ShadowDepth="0"
                                 Opacity="0.20"/>
                        </Button.Effect>

                    </Button>

                    <Button x:Name="BotaoHistorico"
               Content="🧾 Histórico"
               Width="145"
               Height="42"
               Canvas.Left="20"
               Canvas.Top="175"

               Background="#FF1F2937"
               Foreground="White"
               BorderBrush="#223B82F6"
               FontWeight="Bold"
               FontSize="13"
               Cursor="Hand" Click="BotaoHistorico_Click"/>

                    <Button Content="💰 Financeiro"
               Width="145"
               Height="42"
               Canvas.Left="20"
               Canvas.Top="230"

               Background="#FF1F2937"
               Foreground="White"
               BorderBrush="#223B82F6"
               FontWeight="Bold"
               FontSize="13"
               Cursor="Hand"/>

                    <!-- CARD INFO -->
                    <Border Width="145"
               Height="72"
               Canvas.Left="20"
               Canvas.Top="305"
               Background="#11FFFFFF"
               CornerRadius="14"
               BorderBrush="#22FFFFFF"
               BorderThickness="1">

                        <Canvas>

                            <Label Content="⚡ WRV Premium"
                      Canvas.Left="12"
                      Canvas.Top="10"
                      FontWeight="Bold"
                      FontSize="13"
                      Foreground="White"/>

                            <Label Content="Sistema moderno&#x0a;e otimizado"
                      Canvas.Left="12"
                      Canvas.Top="33"
                      FontSize="11"
                      Foreground="#FFD1D5DB"/>

                        </Canvas>

                    </Border>

                    <!-- SAIR -->
                    <Button Content="🚪 Sair"
               Width="145"
               Height="40"
               Canvas.Left="20"
               Canvas.Top="392"
               Background="#FFDC2626"
               Foreground="White"
               BorderThickness="0"
               FontWeight="Bold"
               FontSize="13"
               Cursor="Hand" Click="Button_Click"/>

                </Canvas>

            </Border>

            <!-- TOPO -->
            <Border Canvas.Left="185"
       Visibility="Visible"
       Width="615"
       Height="56"
       Background="#11FFFFFF"
       BorderBrush="#22FFFFFF"
       BorderThickness="0,0,0,1">

                <Canvas>

                    <Label Content="Sistema de Controle"
              FontSize="20"
              FontWeight="Bold"
              Foreground="White"
              Canvas.Left="20"
              Canvas.Top="13"/>

                    <Label Content="Gerenciamento inteligente"
              FontSize="11"
              Foreground="#FFD1D5DB"
              Canvas.Left="22"
              Canvas.Top="35"/>

                </Canvas>

            </Border>



            <!-- ================================================= -->
            <!-- FINANCEIRO -->
            <!-- ================================================= -->
            <Grid x:Name="Financeiro"

       Visibility="Visible"
       Width="615"
       Height="394"
       Canvas.Left="185"
       Canvas.Top="56"
       Background="Transparent">

                <Border Width="580"
           Height="350"
           Canvas.Left="18"
           Canvas.Top="20"
           Background="#CCFFFFFF"
           CornerRadius="20">

                    <Grid>

                        <Label Content="💰 Financeiro"
                  FontSize="28"
                  FontWeight="Bold"
                  Foreground="#FF1E293B"
                  Canvas.Left="170"
                  Canvas.Top="120" Margin="188,112,188,187"/>

                        <Label Content="Área financeira do sistema"
                  FontSize="14"
                  Foreground="#FF64748B"
                  Canvas.Left="185"
                  Canvas.Top="170" Margin="212,150,188,174"/>

                        <!-- GRAFICO -->
                        <lvc:CartesianChart
                        Grid.Row="1"
                         Series="{Binding Series}" />
                    </Grid>

                </Border>


            </Grid>
        </Canvas>

    </Viewbox>

</Page>
