                              CellStyle="{StaticResource CelulaDataGridEscuroStyle}"
                              Width="950"
                              Height="470"
                              Canvas.Left="25"
                              Canvas.Top="70"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FontSize="14"
                              RowHeight="36">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Data"
                                                Width="120"
                                                Binding="{Binding DataFormatada}"/>

                            <DataGridTextColumn Header="Descrição"
                                                Width="250"
                                                Binding="{Binding Descricao}"/>

                            <DataGridTextColumn Header="Categoria"
                                                Width="160"
                                                Binding="{Binding Categoria}"/>

                            <DataGridTextColumn Header="Valor"
                                                Width="130"
                                                Binding="{Binding ValorFormatado}"/>

                            <DataGridTextColumn Header="Observação"
                                                Width="*"
                                                Binding="{Binding Observacao}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Canvas>

            </Border>

            <!-- ================================================= -->
            <!-- CADASTRAR GASTO -->
            <!-- ================================================= -->

            <Border Width="555"
                    Height="555"
                    Canvas.Left="1050"
                    Canvas.Top="320"
                    Background="#FF131111"
                    CornerRadius="20">

                <Canvas>

                    <Label Content="➕ Novo Gasto"
                           Canvas.Left="25"
                           Canvas.Top="15"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <Label Content="Descrição"
                           Canvas.Left="25"
                           Canvas.Top="70"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFD1D5DB"/>

                    <TextBox x:Name="TxtDescricaoGasto"
                             Style="{StaticResource CampoEscuroStyle}"
                             Width="500"
                             Height="42"
                             Canvas.Left="25"
                             Canvas.Top="95"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             Padding="10,0"/>

                    <Label Content="Categoria"
                           Canvas.Left="25"
                           Canvas.Top="150"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFD1D5DB"/>

                    <TextBox x:Name="TxtCategoriaGasto"
                             Style="{StaticResource CampoEscuroStyle}"
                             Width="240"
                             Height="42"
                             Canvas.Left="25"
                             Canvas.Top="175"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             Padding="10,0"/>

                    <Label Content="Valor"
                           Canvas.Left="285"
                           Canvas.Top="150"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFD1D5DB"/>

                    <TextBox x:Name="TxtValorGasto"
                             Style="{StaticResource CampoEscuroStyle}"
                             Width="240"
                             Height="42"
                             Canvas.Left="285"
                             Canvas.Top="175"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             Padding="10,0"/>

                    <Label Content="Data"
                           Canvas.Left="25"
                           Canvas.Top="230"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFD1D5DB"/>

                    <DatePicker x:Name="DpDataGasto"
                                Width="240"
                                Height="42"
                                Canvas.Left="25"
                                Canvas.Top="255"
                                Background="#FF181818"
                                Foreground="White"
                                BorderBrush="#FF404040">

                        <DatePicker.Resources>

                            <Style TargetType="{x:Type DatePickerTextBox}">

                                <Setter Property="Background"
                                        Value="#FF181818"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter Property="CaretBrush"
                                        Value="White"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="Padding"
                                        Value="10,0"/>

                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>

                            </Style>

                        </DatePicker.Resources>

                    </DatePicker>

                    <Button Content="📎 Anexar Documento"
                            Width="240"
                            Height="42"
                            Canvas.Left="285"
                            Canvas.Top="250"
                            Click="BotaoAnexarDocumento_Click"
                            Background="#FF7C3AED"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="15"
                            Cursor="Hand"/>

                    <Label Content="Observação"
                           Canvas.Left="25"
                           Canvas.Top="310"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFD1D5DB"/>

                    <TextBox x:Name="TxtObservacaoGasto"
                             Style="{StaticResource CampoEscuroStyle}"
