<Window x:Class="ProjetoIntegrador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetoIntegrador"
        mc:Ignorable="d"
        Title="WRV Control"
        Height="450"
        Width="800">



    <Canvas>

        <!-- ================================================= -->
        <!-- MENU -->
        <!-- ================================================= -->
        <Border Width="185"
                Visibility="Visible"
                Height="450"
                Background="#FF1E1E2F">

            <Canvas>

                <!-- LOGO -->
                <Label Content="WRV CONTROL"
                       Canvas.Left="8"
                       Canvas.Top="26"
                       FontWeight="Bold"
                       FontSize="22"
                       Foreground="White"/>

                <!-- LINHA -->
                <Rectangle Width="140"
                           Height="1"
                           Fill="#55FFFFFF"
                           Canvas.Left="22"
                           Canvas.Top="65"/>

                <!-- BOTÕES -->
                <Button x:Name="BotaoEstoque"
                        Content="📦 Estoque"
                        Width="140"
                        Height="40"
                        Canvas.Left="22"
                        Canvas.Top="95"
                        Click="BotaoEstoque_Click"
                        Background="#FF2B2B40"
                        Foreground="White"
                        BorderBrush="#FF404060"
                        FontWeight="Bold"/>

                <Button x:Name="BotaoHistorico"
                        Content="🧾 Histórico"
                        Width="140"
                        Height="40"
                        Canvas.Left="22"
                        Canvas.Top="145"
                        Click="Button_Click_1"
                        Background="#FF2B2B40"
                        Foreground="White"
                        BorderBrush="#FF404060"
                        FontWeight="Bold"/>

                <Button Content="💰 Financeiro"
                        Width="140"
                        Height="40"
                        Canvas.Left="22"
                        Canvas.Top="195"
                        Click="Button_Click_2"
                        Background="#FF2B2B40"
                        Foreground="White"
                        BorderBrush="#FF404060"
                        FontWeight="Bold"/>

                <Button Content="🚪 Sair"
                        Width="140"
                        Height="40"
                        Canvas.Left="22"
                        Canvas.Top="360"
                        Background="#FFD62D2D"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Border Canvas.Left="185"
                        Visibility="Visible"
                        Width="615"
                        Height="56"
                        Background="White"
                        BorderBrush="#22000000"
                        BorderThickness="0,0,0,1">

                    <Label Content="Sistema de Controle"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FF2B2B40"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"/>

                </Border>

            </Canvas>

        </Border>



        <!-- ================================================= -->
        <!-- HISTÓRICO -->
        <!-- ================================================= -->

        <Canvas x:Name="HistDeVendas"
                Visibility="Collapsed"
                Width="615"
                Height="394"
                Canvas.Left="185"
                Canvas.Top="56"
                Background="#FFF5F5F5">

            <TextBox Width="180"
                     Height="30"
                     Canvas.Left="415"
                     Canvas.Top="15"
                     Text="Pesquisar..."
                     Padding="8"
                     BorderBrush="#FFCCCCCC"
                     Background="White"/>

            <Button x:Name="Comprovante"
                    Content="📄 Comprovante"
                    Width="130"
                    Height="32"
                    Canvas.Left="15"
                    Canvas.Top="15"
                    Click="Button_Click"
                    Background="#FF3B82F6"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Border Width="585"
                    Height="320"
                    Canvas.Left="15"
                    Canvas.Top="60"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#22000000"
                    BorderThickness="1">

                <DataGrid x:Name="Historico1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="White"
                          HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Codigo}"/>

                        <DataGridTextColumn Header="Qtd"
                                            Binding="{Binding Qtd}"/>

                        <DataGridTextColumn Header="Descrição"
                                            Binding="{Binding Descricao}"/>

                        <DataGridTextColumn Header="Valor"
                                            Binding="{Binding Valor}"/>

                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding Data, StringFormat=dd/MM/yyyy}"/>

                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding Cliente}"/>

                        <DataGridTextColumn Header="CPF"
                                            Binding="{Binding CPF}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Canvas>

        <!-- ================================================= -->
        <!-- ESTOQUE -->
        <!-- ================================================= -->

        <Canvas x:Name="Estoque1"
                Visibility="Visible"
                Width="615"
                Height="394"
                Canvas.Left="185"
                Canvas.Top="56"
                Background="#FFF5F5F5">

            <TextBox Width="180"
                     Height="30"
                     Canvas.Left="415"
                     Canvas.Top="15"
                     Text="Pesquisar..."
                     Padding="8"
                     BorderBrush="#FFCCCCCC"
                     Background="White"/>

            <Button x:Name="Cad"
                    Content="➕ Cadastrar"
                    Width="120"
                    Height="32"
                    Canvas.Left="15"
                    Canvas.Top="15"
                    Click="Cad_Click"
                    Background="#FF22C55E"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button x:Name="Exc"
                    Content="🗑 Excluir"
                    Width="100"
                    Height="32"
                    Canvas.Left="145"
                    Canvas.Top="15"
                    Click="Exc_Click"
                    Background="#FFEF4444"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Border Width="585"
                    Height="320"
                    Canvas.Left="15"
                    Canvas.Top="60"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#22000000"
                    BorderThickness="1">

                <DataGrid x:Name="DGestoque"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="White">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Nome"
                                            Binding="{Binding nome}"/>

                        <DataGridTextColumn Header="Quantidade"
                                            Binding="{Binding qnt}"/>

                        <DataGridTextColumn Header="Código de Barras"
                                            Binding="{Binding codbarras}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Canvas>

        <!-- ================================================= -->
        <!-- FINANCEIRO -->
        <!-- ================================================= -->

        <Canvas x:Name="Financeiro"
                Visibility="Collapsed"
                Width="615"
                Height="394"
                Canvas.Left="185"
                Canvas.Top="56"
                Background="#FFF5F5F5">

            <Label Content="Tela Financeira"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#FF2B2B40"
                   Canvas.Left="180"
                   Canvas.Top="140"/>

        </Canvas>

    </Canvas>


</Window>